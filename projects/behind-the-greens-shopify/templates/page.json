    "story_origin": {
      "type": "btg-about-origin",
      "settings": {
        "label": "Where It Started",
        "pull_quote": "You can walk a hundred golf courses and never see the people who made them playable.",
        "body": "<p>Every round starts hours before the first tee time. Crews are out mowing lines, rolling greens and cutting cups. Most golfers never see any of it.</p><p>Behind The Greens started by pointing the camera at that work: the superintendents, the crews and the craft that make a course playable. The films found an audience. The audience became a community. The apparel came from the same place: gear made for the people in those films, and anyone who respects the work.</p>",
        "only_on_page": "our-story"
      }
    },
    "story_values": {
      "type": "btg-about-values",
      "blocks": {
        "value_1": {
          "type": "value",
          "settings": {
            "title": "The Crew Comes First",
            "text": "Every story starts with the people doing the work."
          }
        },
        "value_2": {
          "type": "value",
          "settings": {
            "title": "Culture Over Clichés",
            "text": "No stereotypes, no gimmicks. The real work behind the game."
          }
        },
        "value_3": {
          "type": "value",
          "settings": {
            "title": "Made To Be Worn",
            "text": "Built for early mornings, long days and everywhere after."
          }
        }
      },
      "block_order": [
        "value_1",
        "value_2",
        "value_3"
      ],
      "settings": {
