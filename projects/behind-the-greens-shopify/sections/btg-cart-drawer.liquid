{%- comment -%}
  Behind The Greens cart drawer. Rendered once, globally, near the end
  of layout/theme.liquid:
    {% section 'btg-cart-drawer' %}

  This section is a live mirror of Shopify's real cart object — it is
  re-fetched via the Section Rendering API after every add/update/remove
  so it always reflects real inventory, pricing, and line items. See
  assets/btg-cart-drawer.js for the fetch logic.
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-cart.css' | asset_url | stylesheet_tag }}

  <div class="btg-scrim" data-btg-cart-scrim hidden></div>

  <aside class="btg-cart-drawer" data-btg-cart-drawer hidden aria-hidden="true">
    <div class="btg-cart-drawer__header">
      <div class="btg-display btg-cart-drawer__title">
        Your Cart
        {%- if cart.item_count > 0 -%} ({{ cart.item_count }}){%- endif -%}
      </div>
      <button type="button" class="btg-close-btn" aria-label="Close cart" data-btg-cart-close>&times;</button>
    </div>

    <div class="btg-cart-drawer__items">
      {%- if cart.item_count == 0 -%}
        <div class="btg-cart-drawer__empty">
          <p>Your cart is empty.</p>
          <a href="{{ routes.all_products_collection_url | default: routes.root_url }}" class="btg-link-underline">Continue Shopping</a>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="btg-cart-item" data-btg-cart-line="{{ forloop.index }}">
            <div class="btg-cart-item__media">
              {%- if item.image -%}
                {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title }}
              {%- endif -%}
            </div>
            <div class="btg-cart-item__body">
              <div>
                <a href="{{ item.url }}" class="btg-cart-item__title">{{ item.product.metafields.custom.btg_name.value | default: item.product.title }}</a>
                {%- if item.variant.title != 'Default Title' -%}
                  <div class="btg-cart-item__variant">{{ item.variant.title | replace: ' / ', ' · ' }}</div>
                {%- endif -%}
              </div>
              <div class="btg-cart-item__row">
                <div class="btg-qty-stepper">
                  <button type="button" class="btg-qty-btn" data-btg-qty-decrease data-line="{{ forloop.index }}" aria-label="Decrease quantity">&minus;</button>
                  <span data-btg-qty-value>{{ item.quantity }}</span>
                  <button type="button" class="btg-qty-btn" data-btg-qty-increase data-line="{{ forloop.index }}" aria-label="Increase quantity">+</button>
                </div>
                <span class="btg-cart-item__price">{{ item.final_line_price | money }}</span>
              </div>
              <button type="button" class="btg-remove-link btg-eyebrow" data-btg-remove-line data-line="{{ forloop.index }}">Remove</button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="btg-cart-drawer__footer">
        <div class="btg-cart-drawer__subtotal">
          <span class="btg-eyebrow">Subtotal</span>
          <span class="btg-display" data-btg-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        {%- comment -%}
          Hat discount (code BTG, 30% off). Hidden until the visitor has
          entered the code in the hat popup — btg-hat-discount.js fills in
          the numbers from the pre-discount total below and unhides it.
        {%- endcomment -%}
        <div class="btg-hat-discount-lines" data-btg-hat-lines data-original-cents="{{ cart.original_total_price }}" hidden>
          <div class="btg-cart-drawer__discount">
            <span class="btg-eyebrow">Cole's Discount (BTG) &minus;30%</span>
            <span data-btg-hat-discount-amount></span>
          </div>
          <div class="btg-cart-drawer__subtotal">
            <span class="btg-eyebrow">Total</span>
            <span class="btg-display" data-btg-hat-total></span>
          </div>
        </div>
        <p class="btg-cart-drawer__note">Shipping and taxes calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post" data-btg-checkout-form>
          <button type="submit" name="checkout" class="btg-btn-primary btg-btn-block">Checkout</button>
        </form>
        <div class="btg-cart-drawer__continue">
          <button type="button" class="btg-link-underline" style="background-color:transparent; border:none; cursor:pointer; color:var(--btg-body);" data-btg-cart-close>Continue Shopping</button>
        </div>
      </div>
    {%- endif -%}
  </aside>

  {%- comment -%}
    Hat discount popup. Opens when a hat's own product page loads.
    Logic lives in assets/btg-hat-discount.js.
  {%- endcomment -%}
  {%- liquid
    comment
      Is this a hat's product page? If so the popup opens on page load.
    endcomment
    assign hat_page = ''
    assign hat_words = 'hat,hats,cap,caps,beanie,beanies,headwear' | split: ','
    if template.name == 'product' and product
      assign hat_text = product.title | append: ' ' | append: product.type | append: ' ' | append: product.tags | downcase | replace: '-', ' ' | prepend: ' ' | append: ' '
      for word in hat_words
        assign spaced_word = ' ' | append: word | append: ' '
        if hat_text contains spaced_word
          assign hat_page = 'product'
        endif
      endfor
    endif
  -%}
  <div class="btg-scrim" data-btg-hat-scrim hidden></div>
  <div class="btg-popup btg-popup--badge" data-btg-hat-popup hidden aria-hidden="true" role="dialog" aria-labelledby="btg-hat-popup-title"
       data-money-format="{{ shop.money_format | strip_html | escape }}" data-root="{{ routes.root_url }}" data-hat-page="{{ hat_page }}">
    <button type="button" class="btg-close-btn btg-popup__close" aria-label="Close" data-btg-hat-close>&times;</button>
    <div class="btg-popup__body btg-popup__body--center">
      <div class="btg-eyebrow" style="color:#C1922F; margin-bottom:10px;">A Gift From Cole</div>
      <h2 class="btg-display btg-popup__offer" id="btg-hat-popup-title">Cole has offered you a 30% discount</h2>
      <div class="btg-hat-deadline">
        <span class="btg-eyebrow">Deal ends in</span>
        <span class="btg-hat-deadline__clock" data-btg-hat-countdown>12:00:00</span>
      </div>

      <form class="btg-popup__form" data-btg-hat-form novalidate>
        <p style="font-size:14px; line-height:1.6; color:#A79E86; margin:0 0 12px;" data-btg-hat-message>Enter your code to unlock 30% off your total.</p>
        <input type="text" name="code" placeholder="Enter code" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Discount code" data-btg-hat-input>
        <p class="btg-hat-error" data-btg-hat-error role="alert" hidden>Sorry, that code isn't right. No code, no discount.</p>
        <button type="submit">Apply Code</button>
        <button type="button" class="btg-hat-skip" data-btg-hat-skip>No code — keep shopping</button>
      </form>

      <div data-btg-hat-success hidden>
        <div class="btg-popup__code">
          <span class="btg-popup__code-value">BTG</span>
          <span class="btg-eyebrow btg-popup__code-caption">30% Off Your Total</span>
        </div>
        <p style="font-size:14px; line-height:1.6; color:#A79E86; margin:20px 0 0;">Code accepted! Your 30% off is unlocked&hellip;</p>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'btg-cart-drawer.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'btg-hat-discount.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "BTG Cart Drawer",
  "settings": []
}
{% endschema %}
