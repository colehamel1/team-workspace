{%- comment -%}
  Anchor id must match the "For Brands" pathway block's jump-link
  (default #for-brands) — keep both in sync if you rename it.
{%- endcomment -%}

{%- liquid
  assign formats = section.blocks | where: 'type', 'format'
  assign tiers = section.blocks | where: 'type', 'tier'
-%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-media-kit.css' | asset_url | stylesheet_tag }}

  <div id="for-brands" class="btg-mk-brands">
    <div class="btg-container">
      <div class="btg-mk-brands__intro">
        <div class="btg-eyebrow" style="color:#A5402C; margin-bottom:16px;">{{ section.settings.eyebrow | default: 'For Brands' }}</div>
        <h2 class="btg-display btg-heading-lg" style="color:#14140F; margin:0 0 20px;">{{ section.settings.heading | default: 'Brand Partnerships' }}</h2>
        <p style="font-size:16px; line-height:1.65; color:#3A392F; margin:0;">{{ section.settings.text }}</p>
      </div>

      {%- if formats.size > 0 -%}
        <div class="btg-mk-formats-block">
          <div class="btg-eyebrow" style="color:#8A7F5C; margin-bottom:24px; font-size:11px;">{{ section.settings.formats_label | default: 'Partnership Formats' }}</div>
          <div class="btg-mk-formats">
            {%- for block in formats -%}
              <div class="btg-mk-format-card" {{ block.shopify_attributes }}>
                <div class="btg-display" style="font-size:17px; color:#14140F; margin-bottom:8px;">{{ block.settings.title }}</div>
                <p style="font-size:13px; line-height:1.6; color:#3A392F; margin:0;">{{ block.settings.text }}</p>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if tiers.size > 0 -%}
        <div>
          <div class="btg-eyebrow" style="color:#8A7F5C; margin-bottom:24px; font-size:11px;">{{ section.settings.tiers_label | default: 'Packages & Rates' }}</div>
          <div class="btg-mk-tiers">
            {%- for block in tiers -%}
              <div class="btg-mk-tier-card" {{ block.shopify_attributes }}>
                <div class="btg-display" style="font-size:20px; color:#14140F; margin-bottom:10px;">{{ block.settings.title }}</div>
                <p style="font-size:13px; line-height:1.6; color:#3A392F; margin:0 0 22px;">{{ block.settings.text }}</p>
                <div class="btg-eyebrow" style="color:#A5402C; font-size:12px;">{{ block.settings.rate | default: '[Rate On Request]' }}</div>
              </div>
            {%- endfor -%}
          </div>
          <p class="btg-mk-proof__note" style="text-align:left; color:#8A7F5C;">{{ section.settings.tiers_note | default: 'Package structure and rates shown are illustrative — final pricing to be confirmed before this kit goes out.' }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BTG MK Brand Partnerships",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For Brands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brand Partnerships" },
    { "type": "textarea", "id": "text", "label": "Positioning text", "default": "Brand partnerships are about access — to an audience that trusts Behind The Greens' position inside golf course culture, and shows up for it. We build integrations around that trust, not around a media buy." },
    { "type": "text", "id": "formats_label", "label": "Formats block label", "default": "Partnership Formats" },
    { "type": "text", "id": "tiers_label", "label": "Rates block label", "default": "Packages & Rates" },
    { "type": "textarea", "id": "tiers_note", "label": "Rates disclaimer", "default": "Package structure and rates shown are illustrative — final pricing to be confirmed before this kit goes out." }
  ],
  "blocks": [
    {
      "type": "format",
      "name": "Partnership format",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Short-Form Integration" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    },
    {
      "type": "tier",
      "name": "Package tier",
      "settings": [
        { "type": "text", "id": "title", "label": "Tier name", "default": "Single Placement" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "text", "id": "rate", "label": "Rate", "default": "[Rate On Request]" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BTG MK Brand Partnerships",
      "blocks": [
        { "type": "format", "settings": { "title": "Short-Form Integration", "text": "Sponsored placement inside our short-form video content." } },
        { "type": "format", "settings": { "title": "Long-Form Integration", "text": "Your brand woven into a full-length feature or story." } },
        { "type": "format", "settings": { "title": "Product Features", "text": "Your product, shown in the field, in our voice." } },
        { "type": "format", "settings": { "title": "Multi-Platform Campaigns", "text": "Coordinated placement across video, social, and newsletter." } },
        { "type": "tier", "settings": { "title": "Single Placement", "text": "One integration, one platform — a focused way to test the audience.", "rate": "[Rate On Request]" } },
        { "type": "tier", "settings": { "title": "Integrated Feature", "text": "A longer-form feature paired with supporting short-form and social.", "rate": "[Rate On Request]" } },
        { "type": "tier", "settings": { "title": "Full Campaign", "text": "Coordinated placement across every platform we run.", "rate": "[Rate On Request]" } }
      ]
    }
  ]
}
{% endschema %}
