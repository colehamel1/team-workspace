{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
{%- comment -%}
  Anchor id must match the "For Brands" pathway block's jump-link
  (default #for-brands) — keep both in sync if you rename it.
{%- endcomment -%}

{%- liquid
  assign formats = section.blocks | where: 'type', 'format'
  assign tiers = section.blocks | where: 'type', 'tier'
-%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-media-kit.css' | asset_url | stylesheet_tag }}

  <div id="for-brands" class="btg-mk-brands">
    <div class="btg-container">
      <div class="btg-mk-brands__intro">
        <div class="btg-eyebrow" style="color:var(--btg-muted); margin-bottom:16px;">{{ section.settings.eyebrow | default: 'For Brands' }}</div>
        <h2 class="btg-display btg-heading-lg" style="color:#14140F; margin:0 0 20px;">{{ section.settings.heading | default: 'Brand Partnerships' }}</h2>
        <p style="font-size:16px; line-height:1.65; color:#3A392F; margin:0;">{{ section.settings.text }}</p>
      </div>

      {%- comment -%} Brand reel: renders only once a real reel is uploaded. {%- endcomment -%}
      {%- if section.settings.reel != blank -%}
        <div class="btg-mk-reel">
          {{ section.settings.reel | video_tag: controls: true, muted: true, playsinline: true, preload: 'metadata', image_size: '1280x' }}
        </div>
      {%- endif -%}

      {%- if formats.size > 0 -%}
        <div class="btg-mk-formats-block">
          <div class="btg-eyebrow" style="color:var(--btg-muted); margin-bottom:24px; font-size:11px;">{{ section.settings.formats_label | default: 'Partnership Formats' }}</div>
          <div class="btg-mk-formats">
            {%- for block in formats -%}
              <div class="btg-mk-format-card" {{ block.shopify_attributes }}>
                <div class="btg-display" style="font-size:17px; color:#14140F; margin-bottom:8px;">{{ block.settings.title }}</div>
                <p style="font-size:13px; line-height:1.6; color:#3A392F; margin:0;">{{ block.settings.text }}</p>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if tiers.size > 0 -%}
        <div>
          <div class="btg-eyebrow" style="color:var(--btg-muted); margin-bottom:24px; font-size:11px;">{{ section.settings.tiers_label | default: 'Packages & Rates' }}</div>
          <div class="btg-mk-tiers">
            {%- for block in tiers -%}
              <div class="btg-mk-tier-card" {{ block.shopify_attributes }}>
                <div class="btg-display" style="font-size:20px; color:#14140F; margin-bottom:10px;">{{ block.settings.title }}</div>
                <p style="font-size:13px; line-height:1.6; color:#3A392F; margin:0 0 22px;">{{ block.settings.text }}</p>
                <div class="btg-display btg-mk-tier__rate">{{ block.settings.rate | default: 'On Request' }}</div>
              </div>
            {%- endfor -%}
          </div>
          {%- if section.settings.tiers_note != blank -%}<p class="btg-mk-proof__note" style="text-align:left; color:var(--btg-muted); margin:24px 0 0;">{{ section.settings.tiers_note }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BTG MK Brand Partnerships",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "For Brands"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brand Partnerships"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Positioning text",
      "default": "Our audience trusts what we show them because it's real work, filmed honestly. Partnerships are built around that trust."
    },
    {
      "type": "text",
      "id": "formats_label",
      "label": "Formats block label",
      "default": "Partnership Formats"
    },
    {
      "type": "text",
      "id": "tiers_label",
      "label": "Rates block label",
      "default": "Packages & Rates"
    },
    {
      "type": "textarea",
      "id": "tiers_note",
      "label": "Rates disclaimer",
      "default": "Every partnership is scoped to your brief."
    },
    {
      "type": "text",
      "id": "only_on_page",
      "label": "Only show on page (handle)",
      "info": "Leave empty to always show. Used when several pages share one template."
    },
    {
      "type": "video",
      "id": "reel",
      "label": "Brand reel (optional)",
      "info": "15–25 seconds. Shows under the intro once uploaded."
    }
  ],
  "blocks": [
    {
      "type": "format",
      "name": "Partnership format",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Short-Form Integration"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    },
    {
      "type": "tier",
      "name": "Package tier",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tier name",
          "default": "Single Placement"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "rate",
          "label": "Rate"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BTG MK Brand Partnerships",
      "blocks": [
        {
          "type": "format",
          "settings": {
            "title": "Short-Form Integration",
            "text": "Sponsored placement inside our short-form video content."
          }
        },
        {
          "type": "format",
          "settings": {
            "title": "Long-Form Integration",
            "text": "Your brand woven into a full-length feature or story."
          }
        },
        {
          "type": "format",
          "settings": {
            "title": "Product Features",
            "text": "Your product, shown in the field, in our voice."
          }
        },
        {
          "type": "format",
          "settings": {
            "title": "Multi-Platform Campaigns",
            "text": "Coordinated placement across video, social, and newsletter."
          }
        },
        {
          "type": "tier",
          "settings": {
            "title": "Single Placement",
            "text": "One integration, one platform — a focused way to test the audience."
          }
        },
        {
          "type": "tier",
          "settings": {
            "title": "Integrated Feature",
            "text": "A longer-form feature paired with supporting short-form and social."
          }
        },
        {
          "type": "tier",
          "settings": {
            "title": "Full Campaign",
            "text": "Coordinated placement across every platform we run."
          }
        }
      ]
    }
  ]
}
{% endschema %}
