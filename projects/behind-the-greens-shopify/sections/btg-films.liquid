{%- comment -%}
  Watch The Work — Behind The Greens film archive.
  One featured "stage" + a strip of course films. Performance: no YouTube
  player loads until someone presses play (thumbnail facade); selecting a
  course swaps the stage's thumbnail/title only. Without JS every film is a
  plain link to YouTube, so nothing is ever a dead end.

  Each film block: course, location (only when confirmed), YouTube URL,
  optional thumbnail override. A film with no URL links to the channel.
{%- endcomment -%}

{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
{%- liquid
  assign channel = section.settings.channel_url | default: 'https://www.youtube.com/@behind_thegreens'
  assign film_count = section.blocks.size
-%}
<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-films.css' | asset_url | stylesheet_tag }}

  <section class="btg-films{% if section.settings.tone == 'light' %} btg-films--light{% endif %}" id="{{ section.settings.anchor | default: 'watch-the-work' }}" data-btg-films>
    <div class="btg-container">
      <header class="btg-films__head">
        <div>
          <div class="btg-mono btg-films__kicker">{{ section.settings.eyebrow | default: 'Watch The Work' }}</div>
          <h2 class="btg-display btg-films__title">{{ section.settings.heading | default: 'Films From Behind The Greens' }}</h2>
        </div>
        <div class="btg-films__meta">
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
          <a href="{{ channel }}" target="_blank" rel="noopener" class="btg-link-underline-lt btg-films__channel">All Films On YouTube</a>
        </div>
      </header>

      {%- if film_count > 0 -%}
        {%- assign first = section.blocks.first -%}
        {%- liquid
          assign f_id = first.settings.youtube.id
          if first.settings.youtube.type != 'youtube'
            assign f_id = ''
          endif
        -%}
        <div class="btg-films__stage" data-btg-films-stage>
          <a class="btg-films__poster" href="{% if f_id != blank %}https://www.youtube.com/watch?v={{ f_id }}{% else %}{{ channel }}{% endif %}" target="_blank" rel="noopener" data-btg-film-play data-video-id="{{ f_id }}" aria-label="Play {{ first.settings.course | escape }}">
            {%- if first.settings.thumbnail != blank -%}
              {{ first.settings.thumbnail | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 1320px) 1224px, 100vw', widths: '600, 900, 1200, 1600', alt: '', data-btg-stage-img: '' }}
            {%- elsif f_id != blank -%}
              <img src="https://i.ytimg.com/vi/{{ f_id }}/maxresdefault.jpg" alt="" loading="lazy" width="1280" height="720" data-btg-stage-img onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ f_id }}/hqdefault.jpg'">
            {%- else -%}
              <img src="https://cdn.shopify.com/s/files/1/0632/2172/7335/files/btg-img-video-still.jpg?v=1790710191" alt="" loading="lazy" width="1000" height="558" data-btg-stage-img>
            {%- endif -%}
            <span class="btg-films__shade" aria-hidden="true"></span>
            <span class="btg-films__frame" aria-hidden="true"></span>
            <span class="btg-films__play" aria-hidden="true"><svg width="22" height="24" viewBox="0 0 11 12"><path d="M0 0l11 6-11 6z" fill="currentColor"/></svg></span>
            <span class="btg-films__caption">
              <span class="btg-mono" data-btg-stage-no>Film 01 / {{ film_count | prepend: '0' | slice: -2, 2 }}</span>
              <span class="btg-display btg-films__course" data-btg-stage-course>{{ first.settings.course }}</span>
              <span class="btg-mono btg-films__place" data-btg-stage-place>{{ first.settings.location }}</span>
            </span>
          </a>
        </div>

        <ol class="btg-films__strip" role="list" aria-label="All films">
          {%- for block in section.blocks -%}
            {%- liquid
              assign vid = block.settings.youtube.id
              if block.settings.youtube.type != 'youtube'
                assign vid = ''
              endif
              assign no = forloop.index | prepend: '0' | slice: -2, 2
              if block.settings.thumbnail != blank
                assign thumb = block.settings.thumbnail | image_url: width: 1600
                assign thumb_sm = block.settings.thumbnail | image_url: width: 640
              elsif vid != blank
                assign thumb = 'https://i.ytimg.com/vi/' | append: vid | append: '/maxresdefault.jpg'
                assign thumb_sm = 'https://i.ytimg.com/vi/' | append: vid | append: '/mqdefault.jpg'
              else
                assign thumb = ''
                assign thumb_sm = ''
              endif
            -%}
            <li {{ block.shopify_attributes }}>
              <a class="btg-films__card{% if forloop.first %} is-active{% endif %}"
                 href="{% if vid != blank %}https://www.youtube.com/watch?v={{ vid }}{% else %}{{ channel }}{% endif %}" target="_blank" rel="noopener"
                 data-btg-film-select
                 data-video-id="{{ vid }}"
                 data-thumb="{{ thumb }}"
                 data-no="Film {{ no }} / {{ film_count | prepend: '0' | slice: -2, 2 }}"
                 data-course="{{ block.settings.course | escape }}"
                 data-place="{{ block.settings.location | escape }}"
                 {% if forloop.first %}aria-current="true"{% endif %}>
                <span class="btg-films__thumb">
                  {%- if thumb_sm != blank -%}
                    <img src="{{ thumb_sm }}" alt="" loading="lazy" width="320" height="180">
                  {%- else -%}
                    <span class="btg-films__slate btg-display">{{ block.settings.course }}</span>
                  {%- endif -%}
                </span>
                <span class="btg-mono btg-films__no">No. {{ no }}</span>
                <span class="btg-films__card-course">{{ block.settings.course }}</span>
                {%- if block.settings.location != blank -%}<span class="btg-films__card-place">{{ block.settings.location }}</span>{%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.gear_collection != blank and section.settings.gear_collection.products.size > 0 -%}
        <aside class="btg-films__gear" aria-label="Shop the gear">
          <div class="btg-films__gear-head">
            <span class="btg-mono">{{ section.settings.gear_eyebrow | default: 'The Uniform' }}</span>
            <p>{{ section.settings.gear_text | default: 'Made for the people in these films.' }}</p>
            <a href="{{ section.settings.gear_collection.url }}" class="btg-link-underline-lt">Shop The Gear</a>
          </div>
          <div class="btg-films__gear-row">
            {%- for product in section.settings.gear_collection.products limit: 4 -%}
              <a href="{{ product.url }}" class="btg-films__gear-item">
                <span class="btg-films__gear-img">
                  {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', width: 150, height: 150 }}{%- endif -%}
                </span>
                <span class="btg-films__gear-name">{{ product.title }}</span>
                <span class="btg-films__gear-price">{%- if product.price_varies -%}From {% endif %}{{ product.price_min | money }}</span>
              </a>
            {%- endfor -%}
          </div>
        </aside>
      {%- endif -%}
    </div>
  </section>
</div>
<script src="{{ 'btg-films.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "BTG Films",
  "settings": [
    { "type": "select", "id": "tone", "label": "Tone", "options": [{ "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" }], "default": "dark" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "watch-the-work", "info": "Buttons linking to #watch-the-work jump here." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Watch The Work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Films From Behind The Greens" },
    { "type": "textarea", "id": "text", "label": "Intro" },
    { "type": "url", "id": "channel_url", "label": "YouTube channel URL", "default": "https://www.youtube.com/@behind_thegreens" },
    { "type": "header", "content": "Shop the gear" },
    { "type": "collection", "id": "gear_collection", "label": "Gear collection", "info": "A quiet row of products under the films. Leave empty to hide." },
    { "type": "text", "id": "gear_eyebrow", "label": "Gear label", "default": "The Uniform" },
    { "type": "text", "id": "gear_text", "label": "Gear line", "default": "Made for the people in these films." },
    { "type": "text", "id": "only_on_page", "label": "Only show on page (handle)", "info": "Leave empty to always show. Used when several pages share one template." }
  ],
  "blocks": [
    {
      "type": "film",
      "name": "Film",
      "settings": [
        { "type": "text", "id": "course", "label": "Course name" },
        { "type": "text", "id": "location", "label": "Location", "info": "Only add when confirmed, e.g. Scottsdale, AZ." },
        { "type": "video_url", "id": "youtube", "label": "YouTube link", "accept": ["youtube"] },
        { "type": "image_picker", "id": "thumbnail", "label": "Thumbnail override", "info": "Optional. Defaults to the YouTube thumbnail." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "BTG Films" }]
}
{% endschema %}
