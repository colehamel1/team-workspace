{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
{%- comment -%} Platform-by-platform stats, editable per block. {%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-media-kit.css' | asset_url | stylesheet_tag }}

  <div class="btg-mk-platforms-wrap">
    <div class="btg-container">
      {% render 'btg-section-heading', eyebrow: section.settings.eyebrow, title: section.settings.title %}
      <div class="btg-mk-platforms">
        {%- for block in section.blocks -%}
          <div class="btg-mk-platform-card" {{ block.shopify_attributes }}>
            <div class="btg-mk-platform-card__icon">
              <span style="color:#163A2B;">{% render 'btg-social-icon', name: block.settings.icon, size: 26 %}</span>
            </div>
            <span class="btg-visually-hidden">{{ block.settings.name }}</span>
            <div class="btg-display" style="font-size:24px; color:#14140F; margin-bottom:4px;">{{ block.settings.primary_stat }}</div>
            <div style="font-size:13px; color:var(--btg-muted);">{{ block.settings.secondary_stat }}</div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.note != blank -%}
        <p class="btg-mk-proof__note" style="text-align:left; color:var(--btg-muted);">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BTG MK Platforms",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "By Platform"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Where We Show Up"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Disclaimer note"
    },
    {
      "type": "text",
      "id": "only_on_page",
      "label": "Only show on page (handle)",
      "info": "Leave empty to always show. Used when several pages share one template."
    }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Platform",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "newsletter",
              "label": "Newsletter"
            }
          ],
          "default": "instagram"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Platform name",
          "default": "Instagram"
        },
        {
          "type": "text",
          "id": "primary_stat",
          "label": "Primary stat"
        },
        {
          "type": "text",
          "id": "secondary_stat",
          "label": "Secondary stat"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "BTG MK Platforms",
      "blocks": [
        {
          "type": "platform",
          "settings": {
            "icon": "instagram",
            "name": "Instagram"
          }
        },
        {
          "type": "platform",
          "settings": {
            "icon": "tiktok",
            "name": "TikTok"
          }
        },
        {
          "type": "platform",
          "settings": {
            "icon": "youtube",
            "name": "YouTube"
          }
        },
        {
          "type": "platform",
          "settings": {
            "icon": "newsletter",
            "name": "Newsletter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
