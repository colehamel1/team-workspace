{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
{%- comment -%} Platform-by-platform stats, editable per block. {%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-media-kit.css' | asset_url | stylesheet_tag }}

  <div class="btg-mk-platforms-wrap">
    <div class="btg-container">
      {% render 'btg-section-heading', eyebrow: section.settings.eyebrow, title: section.settings.title %}
      <div class="btg-mk-platforms">
        {%- for block in section.blocks -%}
          <div class="btg-mk-platform-card" {{ block.shopify_attributes }}>
            <div class="btg-mk-platform-card__icon">
              {%- case block.settings.icon -%}
                {%- when 'instagram' -%}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="#163A2B" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" stroke="#163A2B" stroke-width="1.6"/><circle cx="17.3" cy="6.7" r="1.1" fill="#163A2B"/></svg>
                {%- when 'tiktok' -%}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M16 3v9.5a3.5 3.5 0 1 1-3.5-3.5" stroke="#163A2B" stroke-width="1.6" stroke-linecap="round"/><path d="M16 3c0 2.4 1.8 4.2 4.2 4.2" stroke="#163A2B" stroke-width="1.6" stroke-linecap="round"/></svg>
                {%- when 'youtube' -%}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" stroke="#163A2B" stroke-width="1.6"/><path d="M10.5 9.5 14.5 12l-4 2.5v-5Z" fill="#163A2B"/></svg>
                {%- when 'facebook' -%}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#163A2B" stroke-width="1.6"/><path d="M14 8.5h-1.5c-.8 0-1.5.7-1.5 1.5v2h3l-.4 2.5H11V19" stroke="#163A2B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- else -%}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="#163A2B" stroke-width="1.6"/><path d="M3.5 6.5 12 13l8.5-6.5" stroke="#163A2B" stroke-width="1.6" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </div>
            <div class="btg-eyebrow" style="color:var(--btg-muted); margin-bottom:10px; font-size:11px;">{{ block.settings.name }}</div>
            <div class="btg-display" style="font-size:24px; color:#14140F; margin-bottom:4px;">{{ block.settings.primary_stat }}</div>
            <div style="font-size:13px; color:var(--btg-muted);">{{ block.settings.secondary_stat }}</div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.note != blank -%}
        <p class="btg-mk-proof__note" style="text-align:left; color:var(--btg-muted);">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BTG MK Platforms",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "By Platform"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Where We Show Up"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Disclaimer note"
    },
    {
      "type": "text",
      "id": "only_on_page",
      "label": "Only show on page (handle)",
      "info": "Leave empty to always show. Used when several pages share one template."
    }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Platform",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "newsletter",
              "label": "Newsletter"
            }
          ],
          "default": "instagram"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Platform name",
          "default": "Instagram"
        },
        {
          "type": "text",
          "id": "primary_stat",
          "label": "Primary stat"
        },
        {
          "type": "text",
          "id": "secondary_stat",
          "label": "Secondary stat"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "BTG MK Platforms",
      "blocks": [
        {
          "type": "platform",
          "settings": {
            "icon": "instagram",
            "name": "Instagram"
          }
        },
        {
          "type": "platform",
          "settings": {
            "icon": "tiktok",
            "name": "TikTok"
          }
        },
        {
          "type": "platform",
          "settings": {
            "icon": "youtube",
            "name": "YouTube"
          }
        },
        {
          "type": "platform",
          "settings": {
            "icon": "newsletter",
            "name": "Newsletter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
