{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-media-kit.css' | asset_url | stylesheet_tag }}

  <div class="btg-mk-hero">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', class: 'btg-mk-hero__image', alt: section.settings.heading }}
    {%- endif -%}
    <div class="btg-mk-hero__scrim"></div>
    <div class="btg-mk-hero__content">
      <div class="btg-eyebrow" style="color:rgba(243,238,223,0.72); margin-bottom:18px;">{{ section.settings.eyebrow | default: 'Work With Us' }}</div>
      <h1 class="btg-display btg-mk-hero__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<p class="btg-mk-hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BTG MK Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Work With Us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be Part Of The Story"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We film the side of golf nobody else does. Here's how courses and brands work with us."
    },
    {
      "type": "text",
      "id": "only_on_page",
      "label": "Only show on page (handle)",
      "info": "Leave empty to always show. Used when several pages share one template."
    }
  ],
  "presets": [
    {
      "name": "BTG MK Hero"
    }
  ]
}
{% endschema %}
