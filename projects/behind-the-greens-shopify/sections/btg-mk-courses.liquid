{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
{%- comment -%}
  Anchor id must match the "For Golf Courses" pathway block's jump-link
  (default #for-courses). Pricing: a limited founding rate shown next to
  the standard rate, so the price can rise honestly once the spots fill.
  Update "Founding spots" in the editor as courses book.
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-media-kit.css' | asset_url | stylesheet_tag }}

  <div id="for-courses" class="btg-mk-courses">
    <div class="btg-container">
      <div class="btg-mk-courses__intro">
        <div class="btg-eyebrow" style="color:#C1922F; margin-bottom:16px;">{{ section.settings.eyebrow | default: 'For Golf Courses' }}</div>
        <h2 class="btg-display btg-heading-lg" style="color:#F3EEDF; margin:0 0 20px;">{{ section.settings.heading | default: 'Behind The Greens: Course Features' }}</h2>
        <p style="font-size:16px; line-height:1.65; color:#EDE6D2; margin:0;">{{ section.settings.text }}</p>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="btg-mk-included">
          {%- for block in section.blocks -%}
            <div class="btg-mk-included__item" {{ block.shopify_attributes }}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12.5 10 17l9-10" stroke="#C1922F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="btg-mk-courses__pricing">
        <div class="btg-mk-price">
          <div class="btg-mk-price__top">
            <span class="btg-eyebrow btg-mk-price__eyebrow">{{ section.settings.pricing_eyebrow | default: 'Pricing' }}</span>
            {%- if section.settings.pricing_spots != blank -%}<span class="btg-mono btg-mk-price__spots">{{ section.settings.pricing_spots }}</span>{%- endif -%}
          </div>
          <div class="btg-display btg-mk-price__amount">{{ section.settings.pricing_label | default: 'By Inquiry' }}</div>
          {%- if section.settings.pricing_standard != blank -%}<div class="btg-mk-price__standard">{{ section.settings.pricing_standard }}</div>{%- endif -%}
          {%- if section.settings.pricing_note != blank -%}<p class="btg-mk-price__note">{{ section.settings.pricing_note }}</p>{%- endif -%}
          {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link | default: routes.root_url }}" class="btg-btn-gold btg-mk-price__cta">{{ section.settings.cta_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BTG MK Course Features",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "For Golf Courses"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Behind The Greens: Course Features"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Positioning text",
      "default": "Behind The Greens travels to your property to produce a documentary-style long-form episode telling the story of your course and the people who maintain it. We film alongside your crew, show what actually goes into keeping the course playable, and sit down with your superintendent to talk operation, philosophy, and history. This is a premium editorial feature — not videography for hire."
    },
    {
      "type": "text",
      "id": "pricing_eyebrow",
      "label": "Price label",
      "default": "Founding Rate"
    },
    {
      "type": "text",
      "id": "pricing_spots",
      "label": "Founding spots",
      "info": "e.g. 5 of 5 spots open. Update as courses book; clear to hide."
    },
    {
      "type": "text",
      "id": "pricing_standard",
      "label": "Standard rate line",
      "info": "e.g. Standard rate $5,000 + travel. Clear to hide."
    },
    {
      "type": "text",
      "id": "pricing_label",
      "label": "Price",
      "default": "Custom & By Inquiry Only"
    },
    {
      "type": "textarea",
      "id": "pricing_note",
      "label": "Pricing note",
      "default": "Every Course Feature is scoped to the property. Reach out and we'll walk through what's possible."
    },
    {
      "type": "text",
      "id": "only_on_page",
      "label": "Only show on page (handle)",
      "info": "Leave empty to always show. Used when several pages share one template."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Apply For A Founding Spot"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "included",
      "name": "What's included item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Documentary-style long-form YouTube episode"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "BTG MK Course Features",
      "blocks": [
        {
          "type": "included",
          "settings": {
            "text": "Documentary-style long-form YouTube episode"
          }
        },
        {
          "type": "included",
          "settings": {
            "text": "On-site filming alongside your maintenance crew"
          }
        },
        {
          "type": "included",
          "settings": {
            "text": "On-camera interview with your superintendent"
          }
        },
        {
          "type": "included",
          "settings": {
            "text": "Full coverage of the course and property"
          }
        },
        {
          "type": "included",
          "settings": {
            "text": "Optional short-form & social distribution"
          }
        },
        {
          "type": "included",
          "settings": {
            "text": "Scope tailored to your course and story"
          }
        }
      ]
    }
  ]
}
{% endschema %}
