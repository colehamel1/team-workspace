{%- comment -%}
  Anchor id must match the "For Golf Courses" pathway block's jump-link
  (default #for-courses). Pricing is intentionally not a number — this
  offering is inquiry-only, per the brand's positioning.
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-media-kit.css' | asset_url | stylesheet_tag }}

  <div id="for-courses" class="btg-mk-courses">
    <div class="btg-container">
      <div class="btg-mk-courses__intro">
        <div class="btg-eyebrow" style="color:#C1922F; margin-bottom:16px;">{{ section.settings.eyebrow | default: 'For Golf Courses' }}</div>
        <h2 class="btg-display" style="font-size:44px; color:#F3EEDF; margin:0 0 20px;">{{ section.settings.heading | default: 'Behind The Greens: Course Features' }}</h2>
        <p style="font-size:16px; line-height:1.65; color:#EDE6D2; margin:0;">{{ section.settings.text }}</p>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="btg-mk-included">
          {%- for block in section.blocks -%}
            <div class="btg-mk-included__item" {{ block.shopify_attributes }}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12.5 10 17l9-10" stroke="#C1922F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="btg-mk-courses__pricing">
        <div class="btg-eyebrow" style="color:#78705C; font-size:11px;">{{ 'media_kit.pricing' | t | default: 'Pricing' }}</div>
        <div class="btg-display" style="font-size:22px; color:#F3EEDF; margin-top:8px;">{{ section.settings.pricing_label | default: 'Custom & By Inquiry Only' }}</div>
        <p style="font-size:14px; color:#A79E86; margin:8px 0 0; max-width:500px;">{{ section.settings.pricing_note | default: "Every Course Feature is scoped to the property. Reach out and we'll walk through what's possible." }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BTG MK Course Features",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For Golf Courses" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Behind The Greens: Course Features" },
    { "type": "textarea", "id": "text", "label": "Positioning text", "default": "Behind The Greens travels to your property to produce a documentary-style long-form episode telling the story of your course and the people who maintain it. We film alongside your crew, show what actually goes into keeping the course playable, and sit down with your superintendent to talk operation, philosophy, and history. This is a premium editorial feature — not videography for hire." },
    { "type": "text", "id": "pricing_label", "label": "Pricing label", "default": "Custom & By Inquiry Only" },
    { "type": "textarea", "id": "pricing_note", "label": "Pricing note", "default": "Every Course Feature is scoped to the property. Reach out and we'll walk through what's possible." }
  ],
  "blocks": [
    {
      "type": "included",
      "name": "What's included item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Documentary-style long-form YouTube episode" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "BTG MK Course Features",
      "blocks": [
        { "type": "included", "settings": { "text": "Documentary-style long-form YouTube episode" } },
        { "type": "included", "settings": { "text": "On-site filming alongside your maintenance crew" } },
        { "type": "included", "settings": { "text": "On-camera interview with your superintendent" } },
        { "type": "included", "settings": { "text": "Full coverage of the course and property" } },
        { "type": "included", "settings": { "text": "Optional short-form & social distribution" } },
        { "type": "included", "settings": { "text": "Scope tailored to your course and story" } }
      ]
    }
  ]
}
{% endschema %}
