{%- comment -%}
  Stories masthead — reads like the cover line of a field journal.
  Counts and tags come from the real blog; nothing is invented.
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-stories.css' | asset_url | stylesheet_tag }}

  <header class="btg-container btg-journal-head">
    <div class="btg-journal-head__rule">
      <span class="btg-mono">{{ section.settings.eyebrow | default: 'Field Notes' }}</span>
      <span class="btg-mono">{{ blog.articles_count }} {% if blog.articles_count == 1 %}Entry{% else %}Entries{% endif %}</span>
    </div>
    <h1 class="btg-display btg-journal-head__title">{{ section.settings.heading | default: 'Stories' }}</h1>
    {%- if section.settings.tagline != blank -%}
      <p class="btg-editorial btg-journal-head__tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}

    {%- if blog.all_tags.size > 0 -%}
      <nav class="btg-journal-tags" aria-label="Filter stories">
        <a href="{{ blog.url }}" class="btg-journal-tag{% if blog.current_tags == blank %} is-active{% endif %}">All</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="btg-journal-tag{% if blog.current_tags contains tag %} is-active{% endif %}">{{ tag }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </header>
</div>

{% schema %}
{
  "name": "BTG Stories Header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Field Notes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "The people, the culture and the work most golfers never see." }
  ]
}
{% endschema %}
