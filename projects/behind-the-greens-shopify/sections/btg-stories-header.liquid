{%- comment -%}
  Stories page header + tag filters. Place at the top of templates/blog.json
  (create a Shopify Blog named "Stories" and assign this template to it —
  see README). Filter chips use native blog tag filtering
  (/blogs/handle/tagged/tag-handle), driven by whatever tags you put on
  articles (e.g. "Course Features", "Crew Profiles", "Field Notes").
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-stories.css' | asset_url | stylesheet_tag }}

  <div class="btg-container" style="padding-top:88px; padding-bottom:48px;">
    <div class="btg-eyebrow" style="color:#4C7A4A; margin-bottom:16px;">{{ section.settings.eyebrow | default: 'Stories' }}</div>
    <h1 class="btg-display" style="font-size:64px; margin:0 0 18px; max-width:700px;">{{ section.settings.heading | default: 'From Behind The Greens' }}</h1>
    {%- if section.settings.tagline != blank -%}
      <p class="btg-editorial" style="font-family:'Newsreader', serif; font-style:italic; font-size:19px; color:#3A392F; max-width:480px; margin:0;">{{ section.settings.tagline }}</p>
    {%- endif -%}
  </div>

  {%- if blog.all_tags.size > 0 -%}
    <div class="btg-container" style="padding-bottom:0;">
      <div class="btg-shop-filters">
        <a href="{{ blog.url }}" class="btg-chip btg-eyebrow{% if blog.current_tags == blank %} is-active{% endif %}">All</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="btg-chip btg-eyebrow{% if blog.current_tags contains tag %} is-active{% endif %}">{{ tag }}</a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "BTG Stories Header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From Behind The Greens" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "The people, the culture, and the work most golfers never see." }
  ]
}
{% endschema %}
