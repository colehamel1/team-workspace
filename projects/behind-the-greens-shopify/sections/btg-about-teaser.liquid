{%- comment -%} Homepage About teaser, links out to the full Our Story page. {%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-home.css' | asset_url | stylesheet_tag }}

  <div class="btg-container">
    <div class="btg-about-teaser">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'btg-about-teaser__image', alt: shop.name }}
      {%- endif -%}
      <div>
        <div class="btg-eyebrow" style="color:#4C7A4A; margin-bottom:14px;">{{ section.settings.eyebrow | default: 'Our Story' }}</div>
        <h2 class="btg-display" style="font-size:36px; color:#14140F; margin:0 0 16px;">{{ section.settings.heading }}</h2>
        <p style="font-size:16px; line-height:1.65; color:#3A392F; max-width:480px; margin:0 0 20px;">{{ section.settings.text }}</p>
        {%- if section.settings.link_label != blank -%}
          <a href="{{ section.settings.link }}" class="btg-link-underline" style="border-color:#163A2B; color:#163A2B;">{{ section.settings.link_label }} &rarr;</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BTG About Teaser",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Crest / image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More Than Merch" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A window into the world most golfers never see — now a community, and a uniform." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read Our Full Story" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "BTG About Teaser" }]
}
{% endschema %}
