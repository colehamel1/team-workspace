{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
{%- comment -%} Homepage story teaser: split photo / copy, links to the full Our Story page. {%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-home.css' | asset_url | stylesheet_tag }}

  <section class="btg-split">
    <div class="btg-split__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 860px) 50vw, 100vw', widths: '600, 900, 1200, 1600', alt: section.settings.image.alt | default: '' }}
      {%- else -%}
        <div class="btg-split__fallback"></div>
      {%- endif -%}
    </div>
    <div class="btg-split__copy">
      <div class="btg-eyebrow" style="color:var(--btg-muted); margin-bottom:20px;">{{ section.settings.eyebrow | default: 'Our Story' }}</div>
      <h2 class="btg-display btg-heading-lg" style="margin:0 0 24px;">{{ section.settings.heading }}</h2>
      <p class="btg-lede" style="margin-bottom:36px;">{{ section.settings.text }}</p>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: '/pages/our-story' }}" class="btg-btn-outline">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BTG About Teaser",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Golf Has A Back Of House"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Before the first tee time, a crew has already mowed, rolled and set every hole. That's the work we film, and the people we make gear for."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "only_on_page",
      "label": "Only show on page (handle)",
      "info": "Leave empty to always show. Used when several pages share one template."
    }
  ],
  "presets": [
    {
      "name": "BTG About Teaser"
    }
  ]
}
{% endschema %}
