{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
{%- comment -%}
  Audience proof strip — the community behind the brand, stated plainly.
  Every figure is merchant-entered in section settings (never generated).
  Keep the source/date note accurate when numbers are refreshed.
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-home.css' | asset_url | stylesheet_tag }}

  <section class="btg-proof{% if section.settings.style == 'dark' %} btg-proof--dark{% elsif section.settings.style == 'scale' %} btg-proof--scale{% endif %}{% if section.settings.compact %} btg-proof--compact{% endif %}">
    <div class="btg-container">
      <div class="btg-proof__grid">
        <div class="btg-proof__intro">
          {%- if section.settings.eyebrow != blank -%}<div class="btg-eyebrow btg-proof__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="btg-display btg-proof__heading">{{ section.settings.heading }}</h2>{%- endif -%}
          <div class="btg-proof__social">
            <a href="https://www.instagram.com/behind_thegreens/" target="_blank" rel="noopener" class="btg-eyebrow">Instagram</a>
            <a href="https://www.facebook.com/MrGreenskeeper" target="_blank" rel="noopener" class="btg-eyebrow">Facebook</a>
            <a href="https://www.youtube.com/@behind_thegreens" target="_blank" rel="noopener" class="btg-eyebrow">YouTube</a>
            <a href="https://www.tiktok.com/@behind_thegreens" target="_blank" rel="noopener" class="btg-eyebrow">TikTok</a>
          </div>
        </div>
        <div class="btg-proof__stats">
          {%- for block in section.blocks -%}
            <div class="btg-proof__stat" {{ block.shopify_attributes }}>
              <div class="btg-display btg-proof__value">{{ block.settings.value }}</div>
              <div class="btg-proof__label">{{ block.settings.label }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if section.settings.note != blank -%}<p class="btg-proof__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BTG Proof Strip",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "scale",
          "label": "Scale (dark, oversized numbers)"
        }
      ],
      "default": "dark"
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Compact",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Crew"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Followed By The People Who Keep Golf Running"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Source note"
    },
    {
      "type": "text",
      "id": "only_on_page",
      "label": "Only show on page (handle)",
      "info": "Leave empty to always show. Used when several pages share one template."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "BTG Proof Strip"
    }
  ]
}
{% endschema %}
