{%- comment -%}
  Behind The Greens collection/shop page. Products, pagination and filter
  chips all come from the real `collection` object. Filter chips appear
  only when products carry tags (e.g. "Headwear", "Tees", "Outerwear").
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-shop.css' | asset_url | stylesheet_tag }}

  <header class="btg-container btg-shop-head">
    <div class="btg-eyebrow" style="color:var(--btg-muted); margin-bottom:18px;">{{ section.settings.eyebrow | default: 'The Collection' }}</div>
    <h1 class="btg-display btg-heading-xl" style="margin:0 0 20px;">
      {%- if collection.handle == 'all' -%}{{ section.settings.all_title | default: 'Shop All' }}{%- else -%}{{ collection.title }}{%- endif -%}
    </h1>
    {%- if collection.description != blank and collection.handle != 'all' -%}
      <div class="btg-lede">{{ collection.description }}</div>
    {%- elsif section.settings.tagline != blank -%}
      <p class="btg-editorial" style="font-size:21px; line-height:1.45; color:var(--btg-body); max-width:520px;">{{ section.settings.tagline }}</p>
    {%- endif -%}
  </header>

  <div class="btg-container">
    <div class="btg-shop-bar">
      <div class="btg-shop-filters">
        {%- if collection.all_tags.size > 0 -%}
          <a href="{{ collection.url }}" class="btg-chip{% if collection.current_tags == blank %} is-active{% endif %}">All</a>
          {%- for tag in collection.all_tags -%}
            <a href="{{ collection.url }}/{{ tag | handle }}" class="btg-chip{% if collection.current_tags contains tag %} is-active{% endif %}">{{ tag }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <span class="btg-small">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</span>
    </div>
  </div>

  <div class="btg-container" style="padding-bottom:var(--btg-section);">
    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size == 0 -%}
        <div style="padding:80px 0; text-align:center;">
          <p class="btg-lede" style="margin:0 auto 24px;">Nothing here right now.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btg-btn-outline">Shop All</a>
        </div>
      {%- else -%}
        <div class="btg-grid-3 btg-shop-grid">
          {%- for product in collection.products -%}
            {% render 'btg-product-card', product: product %}
            {%- if section.settings.band_after > 0 and forloop.index == section.settings.band_after and forloop.length > forloop.index and paginate.current_page == 1 -%}
              <a href="{{ section.settings.band_link | default: '/pages/our-story' }}" class="btg-shop-band">
                <span class="btg-shop-band__img">
                  {%- if section.settings.band_image != blank -%}
                    {{ section.settings.band_image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600, 2000', alt: '' }}
                  {%- endif -%}
                </span>
                <span class="btg-shop-band__copy">
                  <span class="btg-mono">{{ section.settings.band_eyebrow }}</span>
                  <span class="btg-display">{{ section.settings.band_heading }}</span>
                  {%- if section.settings.band_link_label != blank -%}<span class="btg-link-underline-lt">{{ section.settings.band_link_label }}</span>{%- endif -%}
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="btg-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btg-eyebrow">&larr; Previous</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}" class="btg-eyebrow">{{ part.title }}</a>{%- else -%}<span class="btg-eyebrow is-active">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btg-eyebrow">Next &rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "BTG Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "all_title",
      "label": "Heading on the all-products page",
      "default": "Shop All"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Built for the people who show up before the flag does."
    },
    {
      "type": "header",
      "content": "Story band"
    },
    {
      "type": "range",
      "id": "band_after",
      "label": "Show after product #",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 3,
      "info": "0 hides it."
    },
    {
      "type": "image_picker",
      "id": "band_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "band_eyebrow",
      "label": "Label",
      "default": "Behind The Greens"
    },
    {
      "type": "text",
      "id": "band_heading",
      "label": "Heading",
      "default": "Golf Has A Back Of House"
    },
    {
      "type": "text",
      "id": "band_link_label",
      "label": "Link label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "band_link",
      "label": "Link"
    }
  ]
}
{% endschema %}
