{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
{%- comment -%}
  Proof of Scale. All figures are merchant-entered in section settings —
  nothing here is invented by the template.
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-media-kit.css' | asset_url | stylesheet_tag }}

  <div class="btg-mk-proof">
    <div class="btg-container">
      <div class="btg-eyebrow" style="color:#78705C; margin-bottom:36px; text-align:center;">{{ section.settings.eyebrow | default: 'Proof Of Scale' }}</div>
      <div class="btg-mk-proof__grid">
        {%- for block in section.blocks -%}
          <div class="btg-mk-proof__stat{% unless forloop.first or forloop.last %} btg-mk-proof__stat--bordered{% endunless %}" {{ block.shopify_attributes }}>
            <div class="btg-display btg-mk-proof__number" style="color:{{ block.settings.color | default: '#F3EEDF' }};">{{ block.settings.value }}</div>
            <div class="btg-eyebrow" style="color:#A79E86; font-size:11px;">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.note != blank -%}
        <p class="btg-mk-proof__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BTG MK Proof Of Scale",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Proof Of Scale"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Disclaimer note"
    },
    {
      "type": "text",
      "id": "only_on_page",
      "label": "Only show on page (handle)",
      "info": "Leave empty to always show. Used when several pages share one template."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "[XXX,XXX]"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Monthly Views"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Number color",
          "default": "#F3EEDF"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "BTG MK Proof Of Scale",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "[XXX,XXX]",
            "label": "Monthly Views"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "[XXX,XXX]",
            "label": "Total Audience",
            "color": "#C1922F"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "[X Platforms]",
            "label": "Cross-Platform Reach"
          }
        }
      ]
    }
  ]
}
{% endschema %}
