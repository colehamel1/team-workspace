{%- comment -%}
  Homepage product teaser. Pulls real products from a merchant-chosen
  collection — nothing hardcoded, automatically reflects catalog changes.
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-shop.css' | asset_url | stylesheet_tag }}
  {{ 'btg-home.css' | asset_url | stylesheet_tag }}

  <div class="btg-container" style="padding:110px 0;">
    <div class="btg-shop-teaser__head">
      {% render 'btg-section-heading', eyebrow: section.settings.eyebrow, title: section.settings.title %}
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="btg-link-underline">{{ section.settings.view_all_label | default: 'View All Products' }} &rarr;</a>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
      <div class="btg-grid-4">
        {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
          {% render 'btg-product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="color:#8A7F5C; font-size:13px; margin:0;">{{ section.settings.empty_state_text | default: 'Choose a collection in section settings to feature products here.' }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "BTG Shop Teaser",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Apparel For The Crew" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View All Products" },
    { "type": "collection", "id": "collection", "label": "Collection to feature" },
    { "type": "range", "id": "product_count", "label": "Number of products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "empty_state_text", "label": "Empty state text", "default": "Choose a collection in section settings to feature products here." }
  ],
  "presets": [{ "name": "BTG Shop Teaser" }]
}
{% endschema %}
