{%- comment -%}
  Behind The Greens header. Rendered directly by layout/theme.liquid
  (Horizon's header group only accepts its own sections). Sticky, with the
  crest + wordmark centered, four nav links left, search/cart right. Links
  are fixed to real destinations (the shared Shopify menu is not used, so
  editing it never changes this theme). Compacts on scroll.
{%- endcomment -%}

<div class="btg-scope btg-header-wrap"{% if template.name == 'index' %} data-btg-header-overlay{% endif %}>
  {% render 'btg-styles' %}

  <header class="btg-header">
    <button type="button" class="btg-mobile-toggle" aria-label="Open menu" aria-expanded="false" data-btg-mobile-nav-toggle>
      <span></span><span></span><span></span>
    </button>

    <nav class="btg-header__nav" aria-label="Primary">
      <a href="{{ routes.all_products_collection_url }}"{% if template.name == 'collection' or template.name == 'product' %} class="active" aria-current="page"{% endif %}>Shop</a>
      <a href="{{ routes.root_url }}#watch-the-work">Films</a>
      <a href="{{ routes.root_url }}pages/our-story"{% if page.handle == 'our-story' %} class="active" aria-current="page"{% endif %}>Story</a>
      <a href="{{ routes.root_url }}pages/media-kit"{% if page.handle == 'media-kit' %} class="active" aria-current="page"{% endif %}>Partnerships</a>
    </nav>

    <a href="{{ routes.root_url }}" class="btg-header__brand" aria-label="{{ shop.name }} home">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 96 | image_tag: class: 'btg-header__logo', alt: '', width: 38, height: 38 }}
      {%- endif -%}
      <span class="btg-display btg-header__wordmark">{{ shop.name }}</span>
    </a>

    <div class="btg-header__icons">
      <span class="btg-header__onjob" aria-hidden="true"><i></i>On The Job</span>
      <script>try{if(sessionStorage.getItem('btg_clocked_in'))document.documentElement.classList.add('btg-on-the-job')}catch(e){}</script>
      <a href="{{ routes.search_url }}" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/><line x1="20.5" y1="20.5" x2="16.2" y2="16.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </a>
      <div class="btg-header__cart-wrap">
        <button type="button" aria-label="Open cart" data-btg-cart-toggle>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5.5 8h13l-1 12.5a1.5 1.5 0 0 1-1.5 1.4h-8a1.5 1.5 0 0 1-1.5-1.4L5.5 8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
        {%- if cart.item_count > 0 -%}
          <span class="btg-header__cart-count" data-btg-cart-count>{{ cart.item_count }}</span>
        {%- endif -%}
      </div>
    </div>
  </header>

  <div class="btg-mobile-nav" data-btg-mobile-nav aria-hidden="true">
    <div class="btg-mobile-nav__top">
      <span class="btg-display" style="color:#F3EEDF; font-size:20px;">{{ shop.name }}</span>
      <button type="button" class="btg-mobile-nav__close" aria-label="Close menu" data-btg-mobile-nav-close>&times;</button>
    </div>
    <nav class="btg-mobile-nav__links" aria-label="Mobile">
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="{{ routes.root_url }}#watch-the-work">Films</a>
      <a href="{{ routes.root_url }}pages/our-story">Story</a>
      <a href="{{ routes.root_url }}pages/media-kit">Partnerships</a>
    </nav>
    <div class="btg-mobile-nav__meta">
      {%- if pages.contact -%}<a href="{{ pages.contact.url }}" class="btg-mobile-nav__contact">Contact</a>{%- endif -%}
      <div class="btg-mobile-nav__social">
        <a href="https://www.instagram.com/behind_thegreens/" target="_blank" rel="noopener" aria-label="Instagram">{% render 'btg-social-icon', name: 'instagram', size: 22 %}</a>
        <a href="https://www.tiktok.com/@behind_thegreens" target="_blank" rel="noopener" aria-label="TikTok">{% render 'btg-social-icon', name: 'tiktok', size: 22 %}</a>
        <a href="https://www.youtube.com/@behind_thegreens" target="_blank" rel="noopener" aria-label="YouTube">{% render 'btg-social-icon', name: 'youtube', size: 22 %}</a>
        <a href="https://www.facebook.com/MrGreenskeeper" target="_blank" rel="noopener" aria-label="Facebook">{% render 'btg-social-icon', name: 'facebook', size: 22 %}</a>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'btg-theme.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "BTG Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo / crest"
    }
  ]
}
{% endschema %}
