{%- comment -%}
  Behind The Greens footer. Rendered directly by layout/theme.liquid.
  Newsletter uses Shopify's native customer form (tagged "newsletter").
  Policy links only render when that policy exists in Settings → Policies,
  so there's never a dead link. Social URLs default to the official
  Behind The Greens profiles and can be overridden in section settings.
{%- endcomment -%}

{%- liquid
  assign ig = section.settings.instagram_url | default: 'https://www.instagram.com/behind_thegreens/'
  assign tt = section.settings.tiktok_url | default: 'https://www.tiktok.com/@behind_thegreens'
  assign yt = section.settings.youtube_url | default: 'https://www.youtube.com/@behind_thegreens'
  assign fb = section.settings.facebook_url | default: 'https://www.facebook.com/MrGreenskeeper'
  assign crest = section.settings.logo | default: settings.favicon
-%}

<div class="btg-scope">
  {% render 'btg-styles' %}

  <footer class="btg-footer">
    <div class="btg-container">

      <div class="btg-footer__top">
        <div class="btg-footer__newsletter">
          <h3 class="btg-display">{{ section.settings.newsletter_heading | default: 'Join The Crew' }}</h3>
          <p>{{ section.settings.newsletter_text | default: 'New stories, new drops, and the occasional dispatch from the crew. No spam.' }}</p>
          {% form 'customer', class: 'btg-footer__form', id: 'btg-footer-newsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="btg-footer__success">You're on the list. Welcome to the crew.</p>
            {%- else -%}
              <label for="btg-footer-email" class="visually-hidden" style="position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0);">Email address</label>
              <input id="btg-footer-email" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
              <button type="submit">Sign Up</button>
            {%- endif -%}
          {% endform %}
        </div>

        <div class="btg-footer__cols">
          <div>
            <div class="btg-eyebrow btg-footer__col-title">Shop</div>
            <div class="btg-footer__col">
              <a href="{{ routes.all_products_collection_url }}">All Products</a>
              {%- for c in collections limit: 6 -%}
                {%- if c.handle != 'all' and c.handle != 'frontpage' and c.all_products_count > 0 and c.handle != 'home-page-1' -%}
                  <a href="{{ c.url }}">{{ c.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <div>
            <div class="btg-eyebrow btg-footer__col-title">Company</div>
            <div class="btg-footer__col">
              <a href="{{ routes.root_url }}pages/our-story">Our Story</a>
              <a href="{{ routes.root_url }}blogs/stories">Stories</a>
              <a href="{{ routes.root_url }}pages/media-kit">Work With Us</a>
              {%- if pages.contact -%}<a href="{{ pages.contact.url }}">Contact</a>{%- endif -%}
            </div>
          </div>

          <div>
            <div class="btg-eyebrow btg-footer__col-title">Follow</div>
            <div class="btg-footer__col">
              <a href="{{ ig }}" target="_blank" rel="noopener">Instagram</a>
              <a href="{{ tt }}" target="_blank" rel="noopener">TikTok</a>
              <a href="{{ yt }}" target="_blank" rel="noopener">YouTube</a>
              <a href="{{ fb }}" target="_blank" rel="noopener">Facebook</a>
            </div>
          </div>
        </div>
      </div>

      <div class="btg-footer__brand">
        {%- if crest != blank -%}
          {{ crest | image_url: width: 120 | image_tag: alt: '', width: 48, height: 48, loading: 'lazy' }}
        {%- endif -%}
        <span class="btg-display">{{ shop.name }}</span>
      </div>

      <div class="btg-footer__bottom">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        <div class="btg-footer__bottom-links">
          {%- if shop.policies.shipping_policy.url -%}<a href="{{ shop.policies.shipping_policy.url }}">Shipping</a>{%- endif -%}
          {%- if shop.policies.refund_policy.url -%}<a href="{{ shop.policies.refund_policy.url }}">Returns</a>{%- endif -%}
          {%- if shop.policies.privacy_policy.url -%}<a href="{{ shop.policies.privacy_policy.url }}">Privacy</a>{%- endif -%}
          {%- if shop.policies.terms_of_service.url -%}<a href="{{ shop.policies.terms_of_service.url }}">Terms</a>{%- endif -%}
          <a href="{{ routes.root_url }}pages/data-sharing-opt-out">Your Privacy Choices</a>
        </div>
      </div>

    </div>
  </footer>
</div>

{% schema %}
{
  "name": "BTG Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo / crest",
      "info": "Falls back to the store favicon (the crest) if left empty."
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join The Crew"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "New stories, new drops, and the occasional dispatch from the crew. No spam."
    },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" }
  ]
}
{% endschema %}
