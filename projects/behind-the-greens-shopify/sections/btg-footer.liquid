{%- comment -%}
  Behind The Greens footer. Rendered directly by layout/theme.liquid
  (see README), not through the theme editor's "Add section" picker —
  same reasoning as btg-header.liquid. Newsletter signup uses Shopify's
  native customer form (tags the contact "newsletter" — no app required).
  Explore/Support columns point at fixed real destinations (same
  reasoning as the header nav) — policy links only render if that
  policy is actually configured in Shopify (Settings → Policies), so
  there's never a dead link. Social links are optional and only show
  once a real URL is filled in.
{%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}

  <footer class="btg-footer">
    <div class="btg-container" style="padding-left:0; padding-right:0; max-width:1240px;">

      <div class="btg-footer__newsletter">
        <div>
          <h3 class="btg-display">{{ section.settings.newsletter_heading | default: 'Join The Crew' }}</h3>
          <p>{{ section.settings.newsletter_text | default: "Stories from behind the greens, new drops, and the occasional dispatch from the crew — straight to your inbox." }}</p>
        </div>
        {% form 'customer', class: 'btg-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p style="color:#F3EEDF; font-size:14px;">Thanks — you're on the list.</p>
          {%- else -%}
            <input type="email" name="contact[email]" placeholder="Your email address" required>
            <button type="submit">Sign Up</button>
          {%- endif -%}
        {% endform %}
      </div>

      <div class="btg-footer__cols">
        <div class="btg-footer__brand">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 68 | image_tag: width: 34, height: 34, style: 'object-fit:contain;', alt: shop.name }}
          {%- endif -%}
          <span class="btg-display">{{ shop.name }}</span>
        </div>

        <div>
          <div class="btg-eyebrow btg-footer__col-title">Explore</div>
          <div class="btg-footer__col">
            <a href="{{ routes.all_products_collection_url }}">Shop</a>
            <a href="{{ routes.root_url }}blogs/stories">Stories</a>
            <a href="{{ routes.root_url }}pages/media-kit#for-courses">Course Features</a>
            <a href="{{ routes.root_url }}pages/media-kit#for-brands">Brand Partnerships</a>
          </div>
        </div>

        {%- assign has_support_link = false -%}
        {%- if pages.contact or shop.policies.shipping_policy.url or shop.policies.refund_policy.url or shop.policies.privacy_policy.url or shop.policies.terms_of_service.url -%}
          {%- assign has_support_link = true -%}
        {%- endif -%}
        {%- if has_support_link -%}
          <div>
            <div class="btg-eyebrow btg-footer__col-title">Support</div>
            <div class="btg-footer__col">
              {%- if pages.contact -%}<a href="{{ pages.contact.url }}">Contact</a>{%- endif -%}
              {%- if shop.policies.shipping_policy.url -%}<a href="{{ shop.policies.shipping_policy.url }}">Shipping</a>{%- endif -%}
              {%- if shop.policies.refund_policy.url -%}<a href="{{ shop.policies.refund_policy.url }}">Returns</a>{%- endif -%}
              {%- if shop.policies.privacy_policy.url -%}<a href="{{ shop.policies.privacy_policy.url }}">Privacy</a>{%- endif -%}
              {%- if shop.policies.terms_of_service.url -%}<a href="{{ shop.policies.terms_of_service.url }}">Terms</a>{%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- assign has_social = false -%}
        {%- if section.settings.instagram_url != blank or section.settings.tiktok_url != blank or section.settings.youtube_url != blank or section.settings.facebook_url != blank -%}
          {%- assign has_social = true -%}
        {%- endif -%}
        {%- if has_social -%}
          <div>
            <div class="btg-eyebrow btg-footer__col-title">Follow</div>
            <div class="btg-footer__col">
              {%- if section.settings.instagram_url != blank -%}<a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
              {%- if section.settings.tiktok_url != blank -%}<a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
              {%- if section.settings.youtube_url != blank -%}<a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener">YouTube</a>{%- endif -%}
              {%- if section.settings.facebook_url != blank -%}<a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="btg-footer__bottom">
        <span>&copy; {{ shop.name }}</span>
        <div class="btg-footer__bottom-links">
          {%- if shop.policies.privacy_policy.url -%}<a href="{{ shop.policies.privacy_policy.url }}">Privacy</a>{%- endif -%}
          {%- if shop.policies.terms_of_service.url -%}<a href="{{ shop.policies.terms_of_service.url }}">Terms</a>{%- endif -%}
        </div>
      </div>

    </div>
  </footer>
</div>

{% schema %}
{
  "name": "BTG Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo / crest"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join The Crew"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Stories from behind the greens, new drops, and the occasional dispatch from the crew — straight to your inbox."
    },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" }
  ]
}
{% endschema %}
