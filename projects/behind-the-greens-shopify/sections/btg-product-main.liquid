{%- comment -%}
  Behind The Greens product page. Everything comes live from the `product`
  object: gallery, options, variants, price, availability, description and
  metafield specs. Variant + cart behavior lives in assets/btg-product-form.js.

  Only real information is shown: the Size & Fit panel appears only when
  sizing content is entered in section settings, and shipping timing is
  left to checkout rather than promised here.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign related_collection = section.settings.related_collection
  if related_collection == blank
    assign related_collection = product.collections.first
  endif
  assign gallery_media = product.media | where: 'media_type', 'image'
  assign initial_media = current_variant.featured_media | default: product.featured_media
  assign lifestyle = product.metafields.custom.lifestyle_image.value
  assign lifestyle_caption = product.metafields.custom.lifestyle_caption.value
  assign slide_count = gallery_media.size
  if lifestyle != blank
    assign slide_count = slide_count | plus: 1
  endif
  assign has_specs = false
  if product.metafields.shopify.fabric != blank or product.metafields.shopify.material != blank or product.metafields.shopify['headwear-features'] != blank
    assign has_specs = true
  endif
-%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-product.css' | asset_url | stylesheet_tag }}

  <div class="btg-container btg-pdp">
    <div class="btg-pdp__grid">

      <!-- GALLERY -->
      <div class="btg-pdp__gallery">
        <div class="btg-pdp__main-media" data-btg-gallery>
          {%- if gallery_media.size > 0 -%}
            {%- for media in gallery_media -%}
              {%- liquid
                assign loading_attr = 'lazy'
                if forloop.first
                  assign loading_attr = 'eager'
                endif
              -%}
              <div class="btg-pdp__slide" data-btg-slide data-media-id="{{ media.id }}">
                {{ media | image_url: width: 1600 | image_tag: loading: loading_attr, sizes: '(min-width: 1000px) 58vw, 100vw', widths: '600, 900, 1200, 1600', alt: media.alt | default: product.title, class: 'btg-pdp__slide-img' }}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="btg-pdp__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
          {%- if lifestyle != blank -%}
            <figure class="btg-pdp__slide btg-pdp__slide--lifestyle" data-btg-slide>
              {%- assign life_focus = product.metafields.custom.lifestyle_focus.value | default: 'center center' -%}
              {%- assign life_style = 'object-position: ' | append: life_focus -%}
              {{ lifestyle | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 58vw, 100vw', widths: '600, 900, 1200, 1600', alt: lifestyle.alt | default: '', class: 'btg-pdp__slide-img', style: life_style }}
              <figcaption class="btg-pdp__slide-caption btg-mono">On The Job{% if lifestyle_caption != blank %} &middot; {{ lifestyle_caption }}{% endif %}</figcaption>
            </figure>
          {%- endif -%}
        </div>
        {%- if slide_count > 1 -%}
          <div class="btg-pdp__thumbs" data-btg-thumbs>
            {%- for media in gallery_media -%}
              <button type="button" class="btg-thumb{% if forloop.first %} active{% endif %}" data-btg-thumb data-index="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }} of {{ slide_count }}">
                {{ media | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
            {%- if lifestyle != blank -%}
              <button type="button" class="btg-thumb" data-btg-thumb data-index="{{ gallery_media.size }}" aria-label="Show on-the-job photo">
                {{ lifestyle | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endif -%}
          </div>
          <div class="btg-pdp__dots" data-btg-dots aria-hidden="true">
            {%- for i in (1..slide_count) -%}
              <span class="btg-dot{% if forloop.first %} active{% endif %}" data-btg-dot></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {%- if initial_media and gallery_media.size > 1 -%}
        <script>
          (function () {
            var mediaId = {{ initial_media.id | json }};
            var gallery = document.querySelector('[data-btg-gallery]');
            if (!mediaId || !gallery) return;
            var slide = gallery.querySelector('[data-media-id="' + mediaId + '"]');
            if (slide) {
              gallery.scrollLeft = slide.getBoundingClientRect().left - gallery.getBoundingClientRect().left + gallery.scrollLeft;
            }
          })();
        </script>
      {%- endif -%}

      <!-- INFO -->
      <div class="btg-pdp__info">
        <div class="btg-pdp__info-inner">
          <nav class="btg-pdp__breadcrumb btg-eyebrow" aria-label="Breadcrumb">
            <a href="{{ routes.all_products_collection_url }}">Shop</a>
            {%- if product.collections.first and product.collections.first.handle != 'home-page-1' -%}
              <span aria-hidden="true">/</span>
              <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
            {%- endif -%}
          </nav>

          {%- assign btg_name = product.metafields.custom.btg_name.value | default: product.title -%}
          <h1 class="btg-display btg-pdp__title">{{ btg_name }}</h1>
          {%- if product.metafields.custom.btg_subtitle.value != blank -%}<p class="btg-pdp__subtitle">{{ product.metafields.custom.btg_subtitle.value }}</p>{%- endif -%}

          <div class="btg-pdp__price" data-btg-price>
            <span class="btg-pdp__price-now">{{ current_variant.price | money }}</span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="btg-pdp__compare-price">{{ current_variant.compare_at_price | money }}</span>
            {%- endif -%}
          </div>

          {% form 'product', product, class: 'btg-pdp__form', id: 'btg-product-form' %}
            <script type="application/json" data-btg-product-json>{{ product.variants | json }}</script>
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-btg-variant-id>

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                {%- assign is_color = false -%}
                {%- if option.name == 'Color' or option.name == 'Colour' -%}{%- assign is_color = true -%}{%- endif -%}
                <fieldset class="btg-pdp__option" data-btg-option-index="{{ forloop.index0 }}"{% if is_color %} data-btg-color-option{% endif %}>
                  <legend class="btg-pdp__option-label">
                    <span class="btg-eyebrow">{{ option.name }}</span>
                    <span class="btg-pdp__option-value" data-btg-option-value-label>{{ current_variant.options[forloop.index0] }}</span>
                  </legend>
                  <div class="btg-pdp__option-values">
                    {%- if is_color -%}
                      {%- for value in option.values -%}
                        {%- capture swatch_color %}{% render 'btg-swatch-color', value: value %}{% endcapture -%}
                        <label class="btg-swatch{% if current_variant.options[forloop.parentloop.index0] == value %} active{% endif %}" title="{{ value | escape }}">
                          <input type="radio" name="option{{ forloop.parentloop.index }}" value="{{ value | escape }}" {% if current_variant.options[forloop.parentloop.index0] == value %}checked{% endif %} data-btg-option-input class="btg-visually-hidden">
                          <span class="btg-swatch__chip" style="background:{{ swatch_color | strip }};"></span>
                          <span class="btg-visually-hidden">{{ value }}</span>
                        </label>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for value in option.values -%}
                        <label class="btg-size-pill{% if current_variant.options[forloop.parentloop.index0] == value %} active{% endif %}">
                          <input type="radio" name="option{{ forloop.parentloop.index }}" value="{{ value | escape }}" {% if current_variant.options[forloop.parentloop.index0] == value %}checked{% endif %} data-btg-option-input class="btg-visually-hidden">
                          <span>{{ value }}</span>
                        </label>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            {%- endunless -%}

            <div class="btg-pdp__add-row">
              <div class="btg-pdp-qty">
                <button type="button" data-btg-pdp-qty-decrease aria-label="Decrease quantity">&minus;</button>
                <span data-btg-pdp-qty-value aria-live="polite">1</span>
                <input type="hidden" name="quantity" value="1" data-btg-pdp-qty-input>
                <button type="button" data-btg-pdp-qty-increase aria-label="Increase quantity">+</button>
              </div>
              <button type="submit" class="btg-btn-primary btg-pdp__atc" data-btg-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
                <span data-btg-add-label>{% if current_variant.available %}Add To Cart{% else %}Sold Out{% endif %}</span>
              </button>
            </div>
          {% endform %}

          <p class="btg-pdp__status" data-btg-availability role="status"{% unless current_variant.available %} style="color:#A5402C;"{% endunless %}>
            {%- unless current_variant.available -%}Sold Out{%- endunless -%}
          </p>

          {%- liquid
            assign film_title = product.metafields.custom.film_title.value
            assign film_url = product.metafields.custom.film_video.value | default: ''
            assign film_id = ''
            if film_url contains 'youtu.be/'
              assign film_id = film_url | split: 'youtu.be/' | last | split: '?' | first
            elsif film_url contains 'v='
              assign film_id = film_url | split: 'v=' | last | split: '&' | first
            endif
          -%}
          {%- if film_title != blank and film_url != blank -%}
            <a class="btg-pdp__seen" href="{% if film_id != blank %}{{ routes.root_url }}?film={{ film_id }}#watch-the-work{% else %}{{ film_url }}{% endif %}">
              {%- if film_id != blank -%}
                <span class="btg-pdp__seen-thumb"><img src="https://i.ytimg.com/vi/{{ film_id }}/mqdefault.jpg" alt="" loading="lazy" width="160" height="90"><span aria-hidden="true"><svg width="10" height="11" viewBox="0 0 11 12"><path d="M0 0l11 6-11 6z" fill="currentColor"/></svg></span></span>
              {%- endif -%}
              <span class="btg-pdp__seen-text">
                <span class="btg-mono">Seen in the film</span>
                <span class="btg-pdp__seen-title">{{ film_title }}</span>
                <span class="btg-pdp__seen-cta">Watch The Work</span>
              </span>
            </a>
          {%- endif -%}

          {%- if section.settings.mission_text != blank -%}
            <div class="btg-pdp__mission">
              <span class="btg-mono">{{ section.settings.mission_label | default: 'Our Mission' }}</span>
              <p>{{ section.settings.mission_text }}</p>
            </div>
          {%- endif -%}

          <ul class="btg-pdp__assurances">
            <li>Secure checkout</li>
            {%- if shop.policies.refund_policy.url -%}<li><a href="{{ shop.policies.refund_policy.url }}">30-day returns on unworn items</a></li>{%- endif -%}
            {%- if pages.contact -%}<li><a href="{{ pages.contact.url }}">Questions? Contact us</a></li>{%- endif -%}
          </ul>

          <div class="btg-pdp__accordions">
            {%- if product.description != blank -%}
              <details class="btg-accordion" open>
                <summary><span class="btg-eyebrow">Details</span><span class="btg-acc-icon" aria-hidden="true"></span></summary>
                <div class="btg-accordion__body btg-pdp__description">{{ product.description }}</div>
              </details>
            {%- endif -%}

            {%- if has_specs -%}
              <details class="btg-accordion">
                <summary><span class="btg-eyebrow">Fabric &amp; Care</span><span class="btg-acc-icon" aria-hidden="true"></span></summary>
                <div class="btg-accordion__body">
                  {%- if product.metafields.shopify.fabric != blank -%}<p>{{ product.metafields.shopify.fabric }}</p>{%- endif -%}
                  {%- if product.metafields.shopify.material != blank -%}<p>{{ product.metafields.shopify.material }}</p>{%- endif -%}
                  {%- if product.metafields.shopify['headwear-features'] != blank -%}<p>{{ product.metafields.shopify['headwear-features'] }}</p>{%- endif -%}
                </div>
              </details>
            {%- endif -%}

            {%- if section.settings.sizing_text != blank -%}
              <details class="btg-accordion">
                <summary><span class="btg-eyebrow">Size &amp; Fit</span><span class="btg-acc-icon" aria-hidden="true"></span></summary>
                <div class="btg-accordion__body">{{ section.settings.sizing_text }}</div>
              </details>
            {%- endif -%}

            <details class="btg-accordion">
              <summary><span class="btg-eyebrow">Shipping &amp; Returns</span><span class="btg-acc-icon" aria-hidden="true"></span></summary>
              <div class="btg-accordion__body">
                {%- if section.settings.shipping_text != blank -%}
                  {{ section.settings.shipping_text }}
                {%- else -%}
                  <p>Shipping options and delivery estimates are shown at checkout before you pay.</p>
                  {%- if shop.policies.refund_policy.url -%}
                    <p>Unworn items can be returned within 30 days of delivery. <a href="{{ shop.policies.refund_policy.url }}">Read the full returns policy</a>.</p>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile sticky add-to-cart: appears once the main button scrolls out of view -->
  <div class="btg-pdp-sticky" data-btg-sticky aria-hidden="true">
    <div class="btg-pdp-sticky__meta">
      <span class="btg-pdp-sticky__title">{{ product.metafields.custom.btg_name.value | default: product.title }}</span>
      <span class="btg-pdp-sticky__price" data-btg-sticky-price>{{ current_variant.price | money }}</span>
    </div>
    <button type="submit" form="btg-product-form" class="btg-btn-primary" data-btg-sticky-btn tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
      <span data-btg-sticky-label>{% if current_variant.available %}Add To Cart{% else %}Sold Out{% endif %}</span>
    </button>
  </div>

  {%- if section.settings.show_film_band -%}
    <a href="{{ routes.root_url }}#watch-the-work" class="btg-pdp-film">
      <span class="btg-pdp-film__copy btg-container">
        <span class="btg-mono">{{ section.settings.film_eyebrow | default: 'Watch The Work' }}</span>
        <span class="btg-display">{{ section.settings.film_heading | default: 'Films From Behind The Greens' }}</span>
        <span class="btg-pdp-film__cta"><svg width="10" height="11" viewBox="0 0 11 12" aria-hidden="true"><path d="M0 0l11 6-11 6z" fill="currentColor"/></svg> Watch The Films</span>
      </span>
    </a>
  {%- endif -%}

  {%- if related_collection and related_collection.products.size > 1 -%}
    {%- assign cross_sell_eyebrow = section.settings.cross_sell_eyebrow | default: 'Complete The Kit' -%}
    {%- assign cross_sell_title = section.settings.cross_sell_title | default: 'You May Also Like' -%}
    <section class="btg-pdp__cross-sell">
      <div class="btg-container">
        <div class="btg-section-heading">
          <div class="btg-eyebrow btg-section-heading__eyebrow" style="color:var(--btg-muted);">{{ cross_sell_eyebrow }}</div>
          <h2 class="btg-display btg-section-heading__title">{{ cross_sell_title }}</h2>
        </div>
        <div class="btg-grid-4">
          {%- assign shown = 0 -%}
          {%- for related in related_collection.products -%}
            {%- if related.id != product.id and shown < 4 -%}
              {% render 'btg-product-card', product: related %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

<script src="{{ 'btg-product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "BTG Product",
  "settings": [
    {
      "type": "collection",
      "id": "related_collection",
      "label": "Related products collection",
      "info": "Defaults to the product's own collection if left blank."
    },
    {
      "type": "text",
      "id": "cross_sell_eyebrow",
      "label": "Related products eyebrow",
      "default": "Complete The Kit"
    },
    {
      "type": "text",
      "id": "cross_sell_title",
      "label": "Related products heading",
      "default": "You May Also Like"
    },
    {
      "type": "richtext",
      "id": "sizing_text",
      "label": "Size & Fit panel",
      "info": "Leave empty to hide the panel. Only add real measurements."
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping & Returns panel",
      "info": "Leave empty to show the default: shipping at checkout + link to your returns policy."
    },
    {
      "type": "header",
      "content": "Mission"
    },
    {
      "type": "text",
      "id": "mission_label",
      "label": "Mission label",
      "default": "Our Mission"
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission text",
      "default": "Every course has a crew that makes the game possible. We exist to give superintendents and their crews the recognition they deserve. Every piece of gear helps us reach more courses and tell more of their stories.",
      "info": "Shown under Add To Cart. Leave empty to hide."
    },
    {
      "type": "header",
      "content": "Film band"
    },
    {
      "type": "checkbox",
      "id": "show_film_band",
      "label": "Show film band",
      "default": true
    },
    {
      "type": "text",
      "id": "film_eyebrow",
      "label": "Label",
      "default": "Watch The Work"
    },
    {
      "type": "text",
      "id": "film_heading",
      "label": "Heading",
      "default": "Films From Behind The Greens"
    }
  ]
}
{% endschema %}
