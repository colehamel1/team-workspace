{%- comment -%}
  Mission moment — a full-bleed maintenance image (or muted loop) with one
  statement and one sentence. A pause in the scroll, not a content block.
{%- endcomment -%}

<div class="btg-scope">
  {{ 'btg-home.css' | asset_url | stylesheet_tag }}
  <section class="btg-mission">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '1600x', class: 'btg-mission__media' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600, 2000', alt: section.settings.image.alt | default: '', class: 'btg-mission__media' }}
    {%- endif -%}
    <span class="btg-mission__shade" aria-hidden="true"></span>
    <div class="btg-container btg-mission__body">
      <h2 class="btg-display btg-mission__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="btg-mission__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "BTG Mission Band",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Use a real maintenance photo: crew, mowers, dew, first light." },
    { "type": "video", "id": "video", "label": "Muted loop (optional)", "info": "Overrides the image. Keep it short and quiet." },
    { "type": "text", "id": "heading", "label": "Statement", "default": "For The People Who Make The Game Possible." },
    { "type": "textarea", "id": "text", "label": "One sentence" }
  ],
  "presets": [{ "name": "BTG Mission Band" }]
}
{% endschema %}
