{%- comment -%}
  Behind The Greens email capture popup. Appears once per browser
  session, a short delay after landing — never twice in the same
  session. Uses Shopify's native customer form (tagged "newsletter") —
  same real signup as the footer, just a second entry point.

  The discount code is intentionally NOT rendered anywhere in the page
  until form.posted_successfully? is true — Shopify's customer form is
  a real server-side POST + reload, so the code genuinely isn't present
  in the page source pre-submission, not just visually hidden. Someone
  can't view-source their way to it without actually submitting an
  email. The code itself must already exist as a real, active discount
  in Shopify (Discounts) — this section only displays it.

  Rendered once, globally, near the end of layout/theme.liquid:
    {% section 'btg-newsletter-popup' %}
{%- endcomment -%}

{%- if section.settings.enabled -%}
<div class="btg-scope" data-btg-popup-delay="{{ section.settings.delay_seconds | default: 4 }}">
  {% render 'btg-styles' %}
  {{ 'btg-cart.css' | asset_url | stylesheet_tag }}

  <div class="btg-scrim" data-btg-popup-scrim hidden></div>

  <div class="btg-popup btg-popup--badge" data-btg-popup hidden aria-hidden="true">
    <button type="button" class="btg-close-btn btg-popup__close" aria-label="Close" data-btg-popup-close>&times;</button>
    <div class="btg-grain"></div>

    <div class="btg-popup__body btg-popup__body--center">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 200 | image_tag: loading: 'lazy', class: 'btg-popup__crest', alt: shop.name }}
      {%- else -%}
        <div class="btg-display btg-popup__wordmark">{{ shop.name }}</div>
      {%- endif -%}

      <div class="btg-popup__rule"></div>

      {% form 'customer', class: 'btg-popup__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          {%- comment -%} Code only ever reaches the page after a real, successful submission. {%- endcomment -%}
          <span data-btg-popup-success hidden></span>
          <div class="btg-eyebrow" style="color:#C1922F; margin-bottom:10px;">{{ section.settings.success_eyebrow | default: "You're In" }}</div>
          <h2 class="btg-display btg-popup__offer">{%- if section.settings.discount_code != blank -%}{{ section.settings.success_heading | default: "Here's Your Code" }}{%- else -%}Welcome To The Crew{%- endif -%}</h2>

          {%- if section.settings.discount_code != blank -%}
            <div class="btg-popup__code">
              <span class="btg-popup__code-value">{{ section.settings.discount_code }}</span>
              <span class="btg-eyebrow btg-popup__code-caption">{{ section.settings.discount_percent | default: '10' }}% Off · Use At Checkout</span>
            </div>
          {%- endif -%}

          <p style="font-size:14px; line-height:1.6; color:#A79E86; margin:20px 0 0;">{{ section.settings.success_text | default: 'Watch your inbox for stories, video drops, and new gear.' }}</p>
        {%- else -%}
          <div class="btg-eyebrow" style="color:#C1922F; margin-bottom:10px;">{{ section.settings.eyebrow | default: 'Join The Crew' }}</div>
          {%- comment -%} The offer only shows when a real discount code is set, so the popup never promises a code it can't deliver. {%- endcomment -%}
          {%- if section.settings.discount_code != blank -%}
            <h2 class="btg-display btg-popup__offer">{{ section.settings.discount_percent | default: '10' }}% Off<br>Your First Order</h2>
          {%- else -%}
            <h2 class="btg-display btg-popup__offer">{{ section.settings.heading | default: 'New Films. New Gear.' }}</h2>
          {%- endif -%}

          <p style="font-size:14px; line-height:1.6; color:#A79E86; margin:0 0 24px;">{{ section.settings.text | default: "A heads up when a new film or new gear drops. No spam." }}</p>

          <input type="email" name="contact[email]" placeholder="Your email address" required>
          <button type="submit">{{ section.settings.button_label | default: 'Unlock My Code' }}</button>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>
{%- endif -%}

<script src="{{ 'btg-newsletter-popup.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "BTG Newsletter Popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable popup", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Crest / logo (falls back to wordmark)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (before signup)", "default": "Join The Crew" },
    { "type": "text", "id": "heading", "label": "Heading (when no discount code is set)", "default": "New Films. New Gear." },
    { "type": "text", "id": "discount_percent", "label": "Discount percent (number only)", "default": "10" },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "default": "CREW10",
      "info": "Must be a real, active discount code under Discounts. Only ever shown after a successful email submission — never rendered in the page before that."
    },
    { "type": "textarea", "id": "text", "label": "Text (before signup)", "default": "A heads up when a new film or new gear drops. No spam." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Unlock My Code" },
    { "type": "text", "id": "success_eyebrow", "label": "Eyebrow (after signup)", "default": "You're In" },
    { "type": "text", "id": "success_heading", "label": "Heading (after signup)", "default": "Here's Your Code" },
    { "type": "textarea", "id": "success_text", "label": "Text (after signup)", "default": "Watch your inbox for stories, video drops, and new gear." },
    { "type": "range", "id": "delay_seconds", "label": "Delay before showing (seconds)", "min": 15, "max": 60, "step": 5, "default": 15 }
  ]
}
{% endschema %}
