{%- comment -%}
  Behind The Greens homepage hero: full-bleed film (or image), headline,
  Watch The Films as the primary entrance and Shop as a quiet secondary
  link. The video pauses while scrolled out of view. Focal points for desktop and phone crops are merchant-set so the
  copy never sits on top of the subject of the footage.
{%- endcomment -%}

{%- liquid
  assign focus_d = section.settings.focus_desktop | default: 'center 40%'
  assign focus_m = section.settings.focus_mobile | default: 'center center'
-%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-home.css' | asset_url | stylesheet_tag }}

  <section class="btg-hero btg-hero--{{ section.settings.content_side | default: 'left' }}" style="--hero-focus-d: {{ focus_d }}; --hero-focus-m: {{ focus_m }};">
    {%- if section.settings.hero_video != blank -%}
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2000', class: 'btg-hero__image', alt: '' }}
      {%- endif -%}
      {%- liquid
        assign hv = section.settings.hero_video
        assign mp4s = hv.sources | where: 'format', 'mp4'
        assign src_sd = ''
        assign src_hd = ''
        assign hd_h = 0
        for src in mp4s
          if src.height <= 540
            assign src_sd = src.url
          endif
          if src.height > hd_h
            assign hd_h = src.height
            assign src_hd = src.url
          endif
        endfor
        if src_sd == blank
          assign src_sd = src_hd
        endif
        if section.settings.image != blank
          assign poster = section.settings.image | image_url: width: 1600
        else
          assign poster = hv.preview_image | image_url: width: 1600
        endif
      -%}
      {%- comment -%}
        Hand-built so only MP4 (H.264) is offered — plays on iPhone, Android
        and desktop. The lighter 480p file serves phones. Poster = the film's
        own first frame, shown instantly while the file loads.
      {%- endcomment -%}
      <video class="btg-hero__video" autoplay muted loop playsinline webkit-playsinline disablepictureinpicture disableremoteplayback preload="auto" poster="{{ poster }}" aria-hidden="true" data-btg-hero-video>
        {%- if src_sd != src_hd -%}<source src="{{ src_sd }}" type="video/mp4" media="(max-width: 767px)">{%- endif -%}
        <source src="{{ src_hd }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2000', class: 'btg-hero__image', alt: '' }}
    {%- endif -%}
    <div class="btg-hero__scrim" style="--hero-scrim: {{ section.settings.scrim | default: 55 | divided_by: 100.0 }};"></div>

    <div class="btg-hero__content">
      {%- if section.settings.eyebrow != blank -%}<div class="btg-eyebrow btg-hero__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1 class="btg-display btg-hero__heading" data-btg-fit>{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<p class="btg-hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="btg-hero__ctas">
        {%- if section.settings.film_label != blank -%}
          <a href="{{ section.settings.film_link | default: '#watch-the-work' }}" class="btg-btn-light btg-hero__cta-primary">
            <svg width="10" height="11" viewBox="0 0 11 12" aria-hidden="true"><path d="M0 0l11 6-11 6z" fill="currentColor"/></svg>
            {{ section.settings.film_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.shop_label != blank -%}
          <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}" class="btg-hero__cta-secondary">{{ section.settings.shop_label }} <span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
      </div>
      {%- if section.settings.show_clock -%}{% render 'btg-clock', fixed: section.settings.clock_time %}{%- endif -%}
    </div>
  </section>
</div>
<script>
  (function(){
    /* Keep the one-line title inside the screen on any font / phone width. */
    var h=document.querySelector('[data-btg-fit]');
    function fit(){if(!h)return;h.style.fontSize='';var box=h.parentNode.clientWidth;var w=h.scrollWidth;if(w>box){var fs=parseFloat(getComputedStyle(h).fontSize);h.style.fontSize=Math.floor(fs*box/w*0.98)+'px'}}
    fit();if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fit);window.addEventListener('resize',fit);

    /* Autoplay muted background film. Retries on first interaction if the
       browser blocked autoplay (e.g. iPhone Low Power Mode); pauses only
       while scrolled out of view. */
    var v=document.querySelector('[data-btg-hero-video]');if(!v)return;
    v.muted=true;v.defaultMuted=true;v.setAttribute('muted','');
    var visible=true;
    function play(){if(!visible)return;var p=v.play();if(p&&p.catch)p.catch(function(){arm()})}
    var armed=false;function arm(){if(armed)return;armed=true;['touchstart','click','scroll','keydown'].forEach(function(t){window.addEventListener(t,function once(){window.removeEventListener(t,once,true);play()},{once:true,passive:true,capture:true})})}
    if(v.readyState>=2)play();else v.addEventListener('loadeddata',play,{once:true});
    v.addEventListener('canplay',function(){if(v.paused)play()},{once:true});
    if('IntersectionObserver' in window){new IntersectionObserver(function(e){e.forEach(function(x){visible=x.isIntersecting;if(visible){if(v.paused)play()}else{v.pause()}})},{threshold:0.05}).observe(v)}
    document.addEventListener('visibilitychange',function(){if(!document.hidden&&v.paused)play()});
  })();
</script>

{% schema %}
{
  "name": "BTG Hero",
  "settings": [
    { "type": "video", "id": "hero_video", "label": "Hero background video", "info": "Autoplays muted and loops. No sound, ever." },
    { "type": "image_picker", "id": "image", "label": "Background image / video poster frame" },
    {
      "type": "select", "id": "focus_desktop", "label": "Desktop crop focus",
      "options": [
        { "value": "center 25%", "label": "Upper" },
        { "value": "center 40%", "label": "Upper-middle" },
        { "value": "center center", "label": "Middle" },
        { "value": "center 70%", "label": "Lower" }
      ],
      "default": "center 40%"
    },
    {
      "type": "select", "id": "focus_mobile", "label": "Phone crop focus",
      "info": "Phones show a tall slice of the film. Pick where the action is.",
      "options": [
        { "value": "25% center", "label": "Left third" },
        { "value": "40% center", "label": "Left of center" },
        { "value": "center center", "label": "Center" },
        { "value": "60% center", "label": "Right of center" },
        { "value": "75% center", "label": "Right third" }
      ],
      "default": "center center"
    },
    {
      "type": "select", "id": "content_side", "label": "Headline position",
      "info": "Put the copy on the side of the frame without the main subject.",
      "options": [{ "value": "left", "label": "Bottom left" }, { "value": "right", "label": "Bottom right" }, { "value": "center", "label": "Centered (one-line title)" }],
      "default": "left"
    },
    { "type": "range", "id": "scrim", "label": "Shade behind the copy", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Behind The Greens" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "film_label", "label": "Primary button label", "default": "Watch The Films" },
    { "type": "text", "id": "film_link", "label": "Primary button link", "default": "#watch-the-work", "info": "#watch-the-work jumps to the films on this page." },
    { "type": "text", "id": "shop_label", "label": "Secondary link label", "default": "Shop The Collection" },
    { "type": "url", "id": "shop_link", "label": "Secondary link" },
    { "type": "header", "content": "Clock In" },
    { "type": "checkbox", "id": "show_clock", "label": "Show Clock In", "default": true },
    { "type": "text", "id": "clock_time", "label": "Pinned time (optional)", "info": "Leave empty to show the visitor's real local time. Or pin it, e.g. 04:53 AM." }
  ],
  "presets": [{ "name": "BTG Hero" }]
}
{% endschema %}
