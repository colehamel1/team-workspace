{%- comment -%} Behind The Greens homepage hero: full-bleed video (or image), headline, two CTAs. All merchant-editable. {%- endcomment -%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-home.css' | asset_url | stylesheet_tag }}

  <div class="btg-hero">
    {%- if section.settings.hero_video != blank -%}
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', class: 'btg-hero__image', alt: section.settings.heading }}
      {%- else -%}
        <div class="btg-grain"></div>
      {%- endif -%}
      {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'auto', image_size: '1920x', class: 'btg-hero__video' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', class: 'btg-hero__image', alt: section.settings.heading }}
    {%- else -%}
      <div class="btg-grain"></div>
    {%- endif -%}
    <div class="btg-hero__scrim"></div>
    <div class="btg-hero__content">
      {%- if section.settings.eyebrow != blank -%}<div class="btg-eyebrow btg-hero__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1 class="btg-display btg-hero__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<p class="btg-hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="btg-hero__ctas">
        {%- if section.settings.primary_label != blank -%}<a href="{{ section.settings.primary_link }}" class="btg-btn-light">{{ section.settings.primary_label }}</a>{%- endif -%}
        {%- if section.settings.secondary_label != blank -%}<a href="{{ section.settings.secondary_link }}" class="btg-btn-outline-lt">{{ section.settings.secondary_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BTG Hero",
  "settings": [
    { "type": "video", "id": "hero_video", "label": "Hero background video", "info": "Autoplays muted and loops. If set, this replaces the background image (the image below is still used as the poster frame shown while the video loads)." },
    { "type": "image_picker", "id": "image", "label": "Background image / video poster frame" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Golf Course Culture" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Behind The Greens" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Behind The Greens tells the story of the crews, culture, and craft that make the game possible — and builds the apparel that carries it." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop The Collection" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Explore Stories" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "BTG Hero" }]
}
{% endschema %}
