{%- comment -%}
  Behind The Greens story page — a field-journal entry.
  Meta line: tag, real filed date/time, and a reading time computed from the
  article's own length. Ends with more entries, the films, and a quiet gear
  row so readers can keep going without being sold to mid-story.

  Sourced stories: end the body with a link to the original source; the
  last link in the body is styled as a "source" callout.
{%- endcomment -%}

{%- liquid
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | plus: 219 | divided_by: 220 | at_least: 1
  assign gear = collections[section.settings.gear_collection_handle]
-%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-stories.css' | asset_url | stylesheet_tag }}

  <article class="btg-entry">
    <header class="btg-container-narrow btg-entry__head">
      <nav class="btg-mono btg-entry__crumbs" aria-label="Breadcrumb">
        <a href="{{ blog.url }}">Field Notes</a>
        {%- if article.tags.size > 0 -%}<span aria-hidden="true">/</span><a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}">{{ article.tags.first }}</a>{%- endif -%}
      </nav>
      <h1 class="btg-display btg-entry__title">{{ article.title }}</h1>
      {%- if article.excerpt != blank -%}
        <p class="btg-editorial btg-entry__dek">{{ article.excerpt | strip_html }}</p>
      {%- endif -%}
      <dl class="btg-entry__meta btg-mono">
        <div><dt>Filed</dt><dd>{{ article.published_at | date: '%b %-d, %Y' }}</dd></div>
        <div><dt>Time</dt><dd>{{ article.published_at | date: '%-I:%M %p' }}</dd></div>
        <div><dt>Read</dt><dd>{{ minutes }} min</dd></div>
        {%- if article.author != blank -%}<div><dt>By</dt><dd>{{ article.author }}</dd></div>{%- endif -%}
      </dl>
    </header>

    {%- if article.image -%}
      <figure class="btg-entry__media">
        {{ article.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2200', alt: article.image.alt | default: article.title }}
        {%- if article.image.alt != blank -%}<figcaption class="btg-mono">{{ article.image.alt }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}

    <div class="btg-container-narrow">
      <div class="btg-entry__body">{{ article.content }}</div>
      <footer class="btg-entry__foot">
        <a href="{{ blog.url }}" class="btg-link-underline">All Field Notes</a>
        {%- if article.tags.size > 0 -%}
          <span class="btg-mono">Filed under {{ article.tags | join: ', ' }}</span>
        {%- endif -%}
      </footer>
    </div>
  </article>

  {%- assign shown = 0 -%}
  {%- capture more -%}
    {%- for other in blog.articles -%}
      {%- if other.id != article.id and shown < 2 -%}
        {%- assign shown = shown | plus: 1 -%}
        <a href="{{ other.url }}" class="btg-entry-more__card">
          <span class="btg-entry-more__img">{%- if other.image -%}{{ other.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 860px) 45vw, 100vw', widths: '450, 700, 900', alt: '' }}{%- endif -%}</span>
          {%- if other.tags.size > 0 -%}<span class="btg-mono">{{ other.tags.first }}</span>{%- endif -%}
          <span class="btg-entry-more__title">{{ other.title }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if shown > 0 -%}
    <section class="btg-entry-more">
      <div class="btg-container">
        <div class="btg-mono btg-entry-more__label">Keep Reading</div>
        <div class="btg-entry-more__grid">{{ more }}</div>
      </div>
    </section>
  {%- endif -%}

  <section class="btg-entry-links">
    <div class="btg-container btg-entry-links__grid">
      <a href="{{ routes.root_url }}#watch-the-work" class="btg-entry-links__card btg-entry-links__card--film">
        <span class="btg-mono">Watch The Work</span>
        <span class="btg-display">Films From The Course</span>
      </a>
      {%- if gear and gear.products.size > 0 -%}
        <a href="{{ gear.url }}" class="btg-entry-links__card">
          <span class="btg-mono">The Uniform</span>
          <span class="btg-display">Made For The Course</span>
          <span class="btg-entry-links__thumbs">
            {%- for p in gear.products limit: 3 -%}{%- if p.featured_media -%}{{ p.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', width: 100, height: 100 }}{%- endif -%}{%- endfor -%}
          </span>
        </a>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "BTG Article",
  "settings": [
    { "type": "text", "id": "gear_collection_handle", "label": "Gear collection handle", "default": "home-page-1", "info": "Collection shown in the 'Made For The Course' card at the end of each story." }
  ]
}
{% endschema %}
