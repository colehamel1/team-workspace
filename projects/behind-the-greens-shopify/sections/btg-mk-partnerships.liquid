{%- if section.settings.only_on_page == blank or section.settings.only_on_page == page.handle -%}
{%- comment -%}
  Brand Partnerships. Answers four questions fast: what a brand gets,
  where it's posted, what BTG handles, what it costs.
  Intro -> compact reach strip -> campaign cards -> CTA -> scope note.
  Anchor id must match the "For Brands" pathway block's jump-link
  (default #for-brands) — keep both in sync if you rename it.
  No guaranteed views, impressions or results are ever stated here.
{%- endcomment -%}

{%- liquid
  assign campaigns = section.blocks | where: 'type', 'campaign'
  assign cta_link = section.settings.cta_link | default: '/pages/contact?topic=brand-partnerships'
-%}

<div class="btg-scope">
  {% render 'btg-styles' %}
  {{ 'btg-media-kit.css' | asset_url | stylesheet_tag }}

  <div id="for-brands" class="btg-mk-brands btg-bp">
    <div class="btg-container">
      <div class="btg-bp__intro">
        <div class="btg-eyebrow btg-bp__eyebrow">{{ section.settings.eyebrow | default: 'Brand Partnerships' }}</div>
        <h2 class="btg-display btg-bp__title">{{ section.settings.heading | default: 'Put your brand inside the golf content people already watch.' }}</h2>
        {%- if section.settings.text != blank -%}<p class="btg-bp__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      {%- if section.settings.reach_total != blank -%}
        <div class="btg-bp-reach">
          <div class="btg-bp-reach__total">
            <span class="btg-display btg-bp-reach__num">{{ section.settings.reach_total }}</span>
            <span class="btg-bp-reach__label">{{ section.settings.reach_label | default: 'Combined Followers' }}</span>
          </div>
          <ul class="btg-bp-reach__list" role="list">
            {%- liquid
              assign reach_ids = 'instagram,facebook,youtube,tiktok' | split: ','
              assign reach_names = 'Instagram,Facebook,YouTube,TikTok' | split: ','
            -%}
            {%- for pid in reach_ids -%}
              {%- assign key = 'reach_' | append: pid -%}
              {%- assign count = section.settings[key] -%}
              {%- if count != blank -%}
                <li class="btg-bp-reach__item">
                  <span class="btg-bp-reach__icon">{% render 'btg-social-icon', name: pid, size: 18 %}</span>
                  <span class="btg-bp-reach__name">{{ reach_names[forloop.index0] }}</span>
                  <strong class="btg-bp-reach__count">{{ count }}</strong>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} Brand reel: renders only once a real reel is uploaded. {%- endcomment -%}
      {%- if section.settings.reel != blank -%}
        <div class="btg-mk-reel">
          {{ section.settings.reel | video_tag: controls: true, muted: true, playsinline: true, preload: 'metadata', image_size: '1280x' }}
        </div>
      {%- endif -%}

      {%- if campaigns.size > 0 -%}
        <div class="btg-bp__options">
          <h3 class="btg-eyebrow btg-bp__options-label">{{ section.settings.options_label | default: 'Campaign Options' }}</h3>
          <div class="btg-bp-grid">
            {%- for block in campaigns -%}
              <article class="btg-bp-card{% if block.settings.featured %} btg-bp-card--featured{% endif %}" {{ block.shopify_attributes }}>
                <header class="btg-bp-card__head">
                  <h4 class="btg-display btg-bp-card__name">{{ block.settings.title }}</h4>
                  <div class="btg-bp-card__price">
                    {%- if block.settings.price_prefix != blank -%}<span class="btg-bp-card__from">{{ block.settings.price_prefix }}</span>{%- endif -%}
                    {%- assign price = block.settings.price | default: 'Custom Pricing' -%}
                    <span class="btg-display btg-bp-card__amount{% unless price contains '$' %} btg-bp-card__amount--word{% endunless %}">{{ price }}</span>
                  </div>
                </header>

                {%- case block.settings.channels -%}
                  {%- when 'short' -%}
                    <div class="btg-bp-card__runs">
                      <span class="btg-bp-card__runs-label" aria-hidden="true">Posted to</span>
                      <span class="btg-bp-card__icons" aria-hidden="true">{% render 'btg-social-icon', name: 'instagram', size: 16 %}{% render 'btg-social-icon', name: 'tiktok', size: 16 %}{% render 'btg-social-icon', name: 'facebook', size: 16 %}{% render 'btg-social-icon', name: 'youtube', size: 16 %}</span>
                      <span class="btg-visually-hidden">Posted to Instagram, TikTok, Facebook and YouTube Shorts</span>
                    </div>
                  {%- when 'film' -%}
                    <div class="btg-bp-card__runs">
                      <span class="btg-bp-card__chip" aria-hidden="true">{% render 'btg-social-icon', name: 'youtube', size: 16 %}Long-form</span>
                      <span class="btg-bp-card__plus" aria-hidden="true">+</span>
                      <span class="btg-bp-card__icons" aria-hidden="true">{% render 'btg-social-icon', name: 'instagram', size: 16 %}{% render 'btg-social-icon', name: 'tiktok', size: 16 %}{% render 'btg-social-icon', name: 'facebook', size: 16 %}{% render 'btg-social-icon', name: 'youtube', size: 16 %}</span>
                      <span class="btg-visually-hidden">Long-form on YouTube, plus short-form on Instagram, TikTok, Facebook and YouTube Shorts</span>
                    </div>
                {%- endcase -%}

                {%- if block.settings.summary != blank -%}<p class="btg-bp-card__summary">{{ block.settings.summary }}</p>{%- endif -%}

                {%- assign lines = block.settings.includes | newline_to_br | split: '<br />' -%}
                <ul class="btg-bp-card__list" role="list">
                  {%- for line in lines -%}
                    {%- assign item = line | strip | remove_first: '* ' | remove_first: '- ' | strip -%}
                    {%- if item != blank -%}<li>{{ item }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </article>
            {%- endfor -%}
          </div>

          <div class="btg-bp__cta">
            <a class="btg-btn-primary btg-bp__cta-btn" href="{{ cta_link }}">{{ section.settings.cta_label | default: 'Start A Partnership' }} <span aria-hidden="true">&rarr;</span></a>
            {%- if section.settings.tiers_note != blank -%}<p class="btg-bp__note">{{ section.settings.tiers_note }}</p>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "BTG MK Partnerships",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Brand Partnerships" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Put your brand inside the golf content people already watch." },
    { "type": "textarea", "id": "text", "label": "Intro text", "default": "Behind The Greens handles the concept, production, editing and distribution, with integrations built naturally into our films and short-form content." },
    { "type": "header", "content": "Reach" },
    { "type": "text", "id": "reach_total", "label": "Combined followers", "default": "410K+" },
    { "type": "text", "id": "reach_label", "label": "Combined followers label", "default": "Combined Followers" },
    { "type": "text", "id": "reach_instagram", "label": "Instagram followers", "default": "110K" },
    { "type": "text", "id": "reach_facebook", "label": "Facebook followers", "default": "164K" },
    { "type": "text", "id": "reach_youtube", "label": "YouTube subscribers", "default": "81K" },
    { "type": "text", "id": "reach_tiktok", "label": "TikTok followers", "default": "55K" },
    { "type": "header", "content": "Campaign options" },
    { "type": "text", "id": "options_label", "label": "Options label", "default": "Campaign Options" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start A Partnership" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Defaults to the contact form with Brand Partnerships selected." },
    { "type": "textarea", "id": "tiers_note", "label": "Scope note", "default": "Every campaign includes concept development, filming, editing and organic distribution through Behind The Greens. Paid usage, exclusivity, travel and additional deliverables can be scoped separately." },
    { "type": "text", "id": "only_on_page", "label": "Only show on page (handle)", "info": "Leave empty to always show. Used when several pages share one template." },
    { "type": "video", "id": "reel", "label": "Brand reel (optional)", "info": "15–25 seconds. Shows under the reach strip once uploaded." }
  ],
  "blocks": [
    {
      "type": "campaign",
      "name": "Campaign option",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Short-Form Feature" },
        { "type": "text", "id": "price_prefix", "label": "Price prefix (optional)", "info": "e.g. Starting at" },
        { "type": "text", "id": "price", "label": "Price", "default": "$1,000" },
        {
          "type": "select", "id": "channels", "label": "Where it's posted",
          "options": [
            { "value": "short", "label": "Short-form (4 platforms)" },
            { "value": "film", "label": "YouTube long-form + short-form" },
            { "value": "none", "label": "Don't show" }
          ],
          "default": "short"
        },
        { "type": "textarea", "id": "summary", "label": "Headline line", "info": "e.g. 3 original short-form brand integrations" },
        { "type": "textarea", "id": "includes", "label": "What's included", "info": "One item per line." },
        { "type": "checkbox", "id": "featured", "label": "Highlight this option", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "BTG MK Partnerships" }]
}
{% endschema %}
