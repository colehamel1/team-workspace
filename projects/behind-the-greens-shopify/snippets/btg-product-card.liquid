{%- comment -%}
  Behind The Greens product card — collection grid, homepage, PDP related.
  Everything is live product data. Shows the second product image on hover
  when one exists. Color dots use the product's own swatch settings.

  Usage: {% render 'btg-product-card', product: product %}
{%- endcomment -%}

{%- liquid
  assign color_option = null
  for option in product.options_with_values
    if option.name == 'Color' or option.name == 'Colour'
      assign color_option = option
    endif
  endfor
  assign images = product.media | where: 'media_type', 'image'
-%}

<a href="{{ product.url }}" class="btg-card{% unless product.available %} btg-card--sold-out{% endunless %}">
  <div class="btg-card__media">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 30vw, 50vw', widths: '360, 540, 720, 900', alt: product.featured_media.alt | default: product.title }}
      {%- if images.size > 1 -%}
        {{ images[1] | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 30vw, 50vw', widths: '360, 540, 720, 900', alt: '', class: 'btg-card__img-alt' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- unless product.available -%}
      <span class="btg-card__badge">Sold Out</span>
    {%- endunless -%}
  </div>

  <div class="btg-card__body">
    <div>
      <h3 class="btg-card__title">{{ product.title }}</h3>
      {%- if color_option and color_option.values.size > 1 -%}
        <div class="btg-card__sub">{{ color_option.values.size }} colors</div>
      {%- endif -%}
    </div>
    <span class="btg-card__price">
      {%- if product.price_varies -%}From {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
    </span>
  </div>
</a>
