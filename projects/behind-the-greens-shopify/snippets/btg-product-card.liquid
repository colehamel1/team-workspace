{%- comment -%}
  Behind The Greens product card — used on the collection grid, homepage
  shop teaser, and PDP cross-sell. Pulls everything live from Shopify.

  Usage: {% render 'btg-product-card', product: product %}

  Color swatches use the product's native "Color" option and its
  merchant-configured swatch color (Shopify admin → product → Options →
  swatches). If no swatch is set for a value, a neutral dot is shown
  instead of guessing a color.
{%- endcomment -%}

{%- liquid
  assign color_option = null
  for option in product.options_with_values
    if option.name == 'Color' or option.name == 'Colour'
      assign color_option = option
    endif
  endfor
-%}

<a href="{{ product.url }}" class="btg-card{% unless product.available %} btg-card--sold-out{% endunless %}">
  <div class="btg-card__media">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.featured_media.alt | default: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- unless product.available -%}
      <span class="btg-card__badge">Sold Out</span>
    {%- endunless -%}
  </div>

  {%- if product.type != blank -%}
    <div class="btg-eyebrow btg-card__cat">{{ product.type }}</div>
  {%- endif -%}

  <div class="btg-card__title">{{ product.title }}</div>

  <div class="btg-card__meta">
    <span class="btg-card__price">
      {%- if product.price_varies -%}
        {{ product.price_min | money }}
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </span>
    {%- if color_option -%}
      <span class="btg-card__swatches">
        {%- for value in color_option.values -%}
          <span class="btg-card__swatch" style="background: {{ value.swatch.color | default: '#8A7F5C' }};" title="{{ value }}"></span>
        {%- endfor -%}
      </span>
    {%- endif -%}
  </div>
</a>
