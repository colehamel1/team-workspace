{%- comment -%}
  Behind The Greens product card — used on the collection grid, homepage
  shop teaser, and PDP cross-sell. Pulls everything live from Shopify.

  Usage: {% render 'btg-product-card', product: product %}

  Color swatches use the product's native "Color" option and its
  merchant-configured swatch color (Shopify admin → product → Options →
  swatches). If no swatch is set for a value, a neutral dot is shown
  instead of guessing a color.
{%- endcomment -%}

{%- liquid
  assign color_option = null
  for option in product.options_with_values
    if option.name == 'Color' or option.name == 'Colour'
      assign color_option = option
    endif
  endfor

  comment
    Hat detection for the hat discount popup (assets/btg-hat-discount.js).
    A product counts as a hat if its type, a tag, or a word in its title is
    hat / hats / cap / caps / beanie / headwear.
  endcomment
  assign is_hat = false
  assign hat_words = 'hat,hats,cap,caps,beanie,beanies,headwear' | split: ','
  assign hat_type = product.type | downcase | strip
  assign hat_title = product.title | downcase | replace: '-', ' ' | prepend: ' ' | append: ' '
  for word in hat_words
    assign spaced_word = ' ' | append: word | append: ' '
    if hat_type == word or hat_title contains spaced_word
      assign is_hat = true
    endif
    for tag in product.tags
      assign tag_lower = tag | downcase | strip
      if tag_lower == word
        assign is_hat = true
      endif
    endfor
  endfor
-%}

<a href="{{ product.url }}" class="btg-card{% unless product.available %} btg-card--sold-out{% endunless %}"{% if is_hat %} data-btg-hat{% endif %}>
  <div class="btg-card__media">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.featured_media.alt | default: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- unless product.available -%}
      <span class="btg-card__badge">Sold Out</span>
    {%- endunless -%}
  </div>

  {%- if product.type != blank -%}
    <div class="btg-eyebrow btg-card__cat">{{ product.type }}</div>
  {%- endif -%}

  <div class="btg-card__title">{{ product.title }}</div>

  <div class="btg-card__meta">
    <span class="btg-card__price">
      {%- if product.price_varies -%}
        {{ product.price_min | money }}
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </span>
    {%- if color_option -%}
      <span class="btg-card__swatches">
        {%- for value in color_option.values -%}
          {%- capture swatch_color %}{% render 'btg-swatch-color', value: value %}{% endcapture -%}
          <span class="btg-card__swatch" style="background: {{ swatch_color | strip }};" title="{{ value }}"></span>
        {%- endfor -%}
      </span>
    {%- endif -%}
  </div>
</a>
