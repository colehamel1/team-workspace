{%- comment -%}
  Brand structured data (JSON-LD) for Google and AI shopping: who we are
  and our official profiles. Homepage only. Rendered from layout/theme.liquid.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  {%- assign org_id = request.origin | append: '/#organization' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ org_id | json }},
          "name": {{ shop.name | json }},
          "url": {{ request.origin | json }},
          {%- if settings.logo != blank -%}"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},{%- endif -%}
          "sameAs": [
            "https://www.instagram.com/behind_thegreens/",
            "https://www.facebook.com/MrGreenskeeper",
            "https://www.youtube.com/@behind_thegreens",
            "https://www.tiktok.com/@behind_thegreens"
          ]
        },
        {
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | json }},
          "publisher": { "@id": {{ org_id | json }} }
        }
      ]
    }
  </script>
{%- endif -%}
